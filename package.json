{
  "name": "issue-tracker",
  "version": "0.1.81",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "prisma generate && next build --webpack",
    "start": "next start -p ${PORT:-3000}",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/verify.mjs ready",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "verify:quick": "node scripts/verify.mjs quick",
    "verify:ready": "node scripts/verify.mjs ready",
    "verify:recheck": "node scripts/verify.mjs recheck",
    "verify:status": "node scripts/verify.mjs status",
    "db:migrate": "prisma migrate dev",
    "db:scenario:open-bids": "tsx --env-file=.env scripts/dev/scenario-open-bids.ts",
    "db:scenario:agents-dock": "tsx --env-file=.env scripts/dev/scenario-agents-dock.ts",
    "db:fixtures": "tsx --env-file=.env scripts/dev/fixtures/run.ts",
    "db:fill-agent-profiles": "tsx --env-file=.env scripts/dev/fill-agent-profiles.ts",
    "db:fixtures:generate": "tsx scripts/dev/fixtures/generate.ts",
    "search:setup": "tsx --env-file=.env scripts/search/index.ts --init",
    "search:enable": "tsx --env-file=.env scripts/search/enable.ts",
    "search:reindex": "tsx --env-file=.env scripts/search/index.ts",
    "search:rebuild": "tsx --env-file=.env scripts/search/index.ts --rebuild",
    "search:outbox": "tsx --env-file=.env scripts/search/outbox.ts",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "postinstall": "prisma generate",
    "e2e": "playwright test",
    "e2e:seed": "tsx e2e/seed.ts",
    "ziki": "tsx --tsconfig cli/tsconfig.json cli/ziki.ts",
    "test:cli": "node scripts/cli-tests.mjs",
    "db:scenario:points-farming": "tsx --env-file=.env scripts/dev/scenario-points-farming.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "next": "16.4.1",
    "next-auth": "5.0.0-beta.32",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "typesense": "^3.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.56.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "^4.14.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "happy-dom": "^21.0.3",
    "jsdom": "^24.0.0",
    "postcss": "^8.5.30",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@10.14.0"
}
