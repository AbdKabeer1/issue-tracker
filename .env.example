# Database Connection:
# - Local dev: Docker Compose postgres service on port 5433 (`docker compose up -d`)
# - Production (Coolify): PostgreSQL service configured in Coolify
DATABASE_URL="postgresql://bugtracker:bugtracker@localhost:5433/bugtracker?schema=public"

# Auth.js Secret — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Auth.js Base URL (full auth endpoint, e.g. http://localhost:3001/api/auth):
# Local development (served from root, matching production at ziki.dev):
AUTH_URL="http://localhost:3001/api/auth"
NEXTAUTH_URL="http://localhost:3001/api/auth"
# Production (Coolify). ziki.dev is canonical; the old issues.zedu.chat host
# is still served, so existing links keep working:
# AUTH_URL="https://ziki.dev/api/auth"
# NEXTAUTH_URL="https://ziki.dev/api/auth"
# Legacy sub-path deployment (contributors.zedu.chat/bug-tracker):
# AUTH_URL="https://contributors.zedu.chat/bug-tracker/api/auth"
# NEXTAUTH_URL="https://contributors.zedu.chat/bug-tracker/api/auth"

# Email/password sign-in (plus forgot/reset password). Zedu Bugs is Google-only
# in production, so this defaults to OFF when NODE_ENV=production and ON in
# local dev (needed for the demo seed logins). Set "true" / "false" to override.
# AUTH_PASSWORD_LOGIN=

# Optional. Google Form opened by the floating "Report issue" button in the
# bottom-right corner. Only https:// links on Google-owned hosts are accepted
# (docs.google.com, forms.gle); anything else leaves the button hidden.
# REPORT_FORM_URL="https://docs.google.com/forms/d/e/<FORM_ID>/viewform"

# Optional Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI in Google Console:
# https://ziki.dev/api/auth/callback/google
# (Old host, while it is still in use: https://issues.zedu.chat/api/auth/callback/google)
# (Legacy sub-path: https://contributors.zedu.chat/bug-tracker/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google sign-in allowlist (#223). Comma-separated; both may be set at once.
# GOOGLE_ALLOWED_EMAILS: exact addresses (case-insensitive), e.g.
#   GOOGLE_ALLOWED_EMAILS="alice@example.com,bob@example.com"
# GOOGLE_ALLOWED_DOMAINS: domains without the @, e.g.
#   GOOGLE_ALLOWED_DOMAINS="zedu.chat,example.org"
# A Google address is admitted when it matches either list (or is a
# SUPER_ADMIN_EMAIL). With neither variable set every Google account is
# auto-provisioned — the historic behaviour, and a startup warning is logged.
# GOOGLE_ALLOWED_EMAILS=
# GOOGLE_ALLOWED_DOMAINS=


# Super admin email(s). Anyone signing in with one of these addresses is granted
# the super_admin role. Comma-separate several, or use SUPER_ADMIN_EMAILS.
# Nothing is hard-coded: with neither set, nobody is auto-promoted.
SUPER_ADMIN_EMAIL="you@example.com"
SUPER_ADMIN_PASSWORD=
# SUPER_ADMIN_NAME="Super Admin"
# Set to "true" to rotate password / promote an existing account to super_admin
# SUPER_ADMIN_FORCE_UPDATE=false
# Set to "true" to wipe users/bugs and load demo data (empty DB seeds demo by default)
# SEED_DEMO_DATA=true

# GitHub App for merging accepted fixes (#452). The agent platform links a pull
# request to an issue and, once the fix is accepted, merges it through the app
# installation on the project (Row in "Project.githubInstallationId"). No token
# is stored: installation tokens are minted on demand and kept in memory only.
# Create the app under GitHub → Settings → Developer settings → GitHub Apps.
# GITHUB_APP_PRIVATE_KEY is the PEM contents; newlines may be literal "\n".
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# SMTP for password-reset and notification emails (AUTH LOGIN + STARTTLS).
# Development: when unset, emails are printed to the server console.
# Production: required. When unset, "Forgot password" says reset emails aren't
# available and notifications are skipped; nothing is written to the logs.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Zedu Bugs <noreply@example.com>"

# Where rate-limit counters live (#296). "postgres" shares them across every
# app instance and survives restarts (needs the RateLimitHit migration);
# "memory" keeps them per process. Unset: postgres in production, memory
# otherwise.
# RATE_LIMIT_STORE=postgres

# Client IP for rate limits (#507). Each proxy in front of the app appends the
# address it saw to X-Forwarded-For, so the client is TRUSTED_PROXY_HOPS entries
# from the right. Traefik/Coolify and Vercel each add one hop (the default).
# Use 2 with a CDN in front of Traefik, or 0 when nothing proxies the app.
# TRUSTED_PROXY_HOPS=1
# Or read one header the platform sets and clients can't forge instead:
# CLIENT_IP_HEADER=cf-connecting-ip

# Webhook dispatcher secret — generate with: openssl rand -base64 32
# Used to authenticate scheduler calls to the webhook dispatch endpoint.
# Required for webhook delivery to work.
# WEBHOOK_DISPATCH_SECRET=

# Agent platform feature flag (#422). Enabled by default (true). Set to "false"
# to explicitly disable agent registry, pairing, and controls in Settings.
# AGENT_PLATFORM=true
# NEXT_PUBLIC_AGENT_PLATFORM=true
