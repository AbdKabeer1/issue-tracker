# Postgres — local Docker Compose (host port 5434) or Neon / Coolify
DATABASE_URL="postgresql://bugtracker:bugtracker@localhost:5433/bugtracker?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# App origin (include basePath when deployed under /bug-tracker)
# Local (next.config basePath=/bug-tracker):
AUTH_URL="http://localhost:3001/bug-tracker"
NEXTAUTH_URL="http://localhost:3001/bug-tracker"
# Production example:
# AUTH_URL="https://contributors.zedu.chat/bug-tracker"
# NEXTAUTH_URL="https://contributors.zedu.chat/bug-tracker"

# Optional Google OAuth (https://console.cloud.google.com/apis/credentials)
# Redirect URI: {AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
