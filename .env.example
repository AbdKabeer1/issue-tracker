# Postgres — local Docker Compose (host port 5434) or Neon / Coolify
DATABASE_URL="postgresql://bugtracker:bugtracker@localhost:5433/bugtracker?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Auth.js base path (origin + /api/auth) — do NOT add next.config basePath here,
# Next.js already prefixes /bug-tracker onto the auth routes.
# Local (next.config basePath=/bug-tracker):
AUTH_URL="http://localhost:3001/api/auth"
NEXTAUTH_URL="http://localhost:3001/api/auth"
# Production example:
# AUTH_URL="https://contributors.zedu.chat/api/auth"
# NEXTAUTH_URL="https://contributors.zedu.chat/api/auth"

# Optional Google OAuth (https://console.cloud.google.com/apis/credentials)
# Redirect URI: {AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Super admin seeder (prisma/seed.ts) — strong password required (min 12 chars).
# Idempotent: existing super_admin is not overwritten unless forced.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
# SUPER_ADMIN_NAME="Super Admin"
# Set to "true" to rotate password / promote an existing account to super_admin
# SUPER_ADMIN_FORCE_UPDATE=false
# Set to "true" to wipe users/bugs and load demo data (empty DB seeds demo by default)
# SEED_DEMO_DATA=true

# Optional SMTP for password-reset emails (AUTH LOGIN + STARTTLS).
# When unset, reset links are logged to the server console (dev-friendly).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Zedu Bugs <noreply@example.com>"
