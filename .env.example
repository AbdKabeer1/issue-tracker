# Database Connection:
# - Local dev: Docker Compose postgres service on port 5433 (`docker compose up -d`)
# - Production (Coolify): Neon cloud PostgreSQL connection string
DATABASE_URL="postgresql://bugtracker:bugtracker@localhost:5433/bugtracker?schema=public"

# Auth.js Secret — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Auth.js Base URL (for subpath deployment at /bug-tracker):
# Local development:
AUTH_URL="http://localhost:3001/bug-tracker"
NEXTAUTH_URL="http://localhost:3001/bug-tracker"
# Production (Coolify):
# AUTH_URL="https://contributors.zedu.chat/bug-tracker"
# NEXTAUTH_URL="https://contributors.zedu.chat/bug-tracker"

# Optional Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI in Google Console:
# https://contributors.zedu.chat/bug-tracker/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# Super admin seeder (prisma/seed.ts) — strong password required (min 12 chars).
# Idempotent: existing super_admin is not overwritten unless forced.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
# SUPER_ADMIN_NAME="Super Admin"
# Set to "true" to rotate password / promote an existing account to super_admin
# SUPER_ADMIN_FORCE_UPDATE=false
# Set to "true" to wipe users/bugs and load demo data (empty DB seeds demo by default)
# SEED_DEMO_DATA=true

# Optional SMTP for password-reset emails (AUTH LOGIN + STARTTLS).
# When unset, reset links are logged to the server console (dev-friendly).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Zedu Bugs <noreply@example.com>"
