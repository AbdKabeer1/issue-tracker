# Postgres connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bug-tracker

# NextAuth: generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me
# Full auth endpoint URL (app is served under /bug-tracker): https://contributors.zedu.chat/bug-tracker/api/auth
NEXTAUTH_URL=http://localhost:3000/bug-tracker/api/auth

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: https://contributors.zedu.chat/bug-tracker/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
