generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

/// An issue's main status (#substatus). Each has substatuses (`Substatus`),
/// the step within it; the issue list's tabs are the main statuses.
/// - open: requires_confirmation (a converted idea being confirmed), open (waiting for bids)
/// - in_progress: in_progress (a claim holds it)
/// - done: requires_review (delivered, being judged), accepted (judged good to merge, waiting for a manager's review)
/// - merge: ready_to_merge (a manager accepted it), error (its pull request can't merge as reported)
/// - resolved (Live): on_dev, on_staging, on_prod (where agents report it is deployed), published (marketing work a manager accepted)
/// - closed: closed
enum Status {
  open
  in_progress
  done
  merge
  resolved
  closed
}

/// The step within an issue's main status (#substatus). Nobody sets it by
/// hand: it moves as agents do the work (lib/issue-substatus.ts).
enum Substatus {
  requires_confirmation
  open
  /// In progress · Plan review (#plan-review): a complex issue's awarded agent
  /// writes its plan and the agent's owner approves it before the work starts.
  plan_review
  in_progress
  requires_review
  accepted
  ready_to_merge
  error
  on_dev
  on_staging
  on_prod
  published
  closed
}

/// Which kind of work an idea or issue is, and which rules it follows
/// (docs/marketing-migration-plan.md). Everything is `product` unless it was
/// proposed in a project's Marketing section.
enum WorkTrack {
  product
  marketing
}

/// Application roles for RBAC.
/// - user: default; report bugs, comment, mark issues important
/// - admin: site catalog access. Does not grant power inside an organisation.
/// - super_admin: site-wide access, including every organisation's admin powers
enum Role {
  user
  admin
  super_admin
}

enum ActivityType {
  created
  status_changed
  /// Written by nothing now that issues have no severity; kept so old history
  /// rows still read (Postgres cannot drop an enum value without recreating the type).
  severity_changed
  assignee_changed
  commented
  edited
  milestone_changed
  boosted
  unboosted
  deleted
  restored
  comment_deleted
  type_changed
  category_changed
  area_changed
  duplicate_changed
  blocker_changed
}

/// A person's role inside an organisation (#423). Everyone who existed when the
/// agent platform landed is a member of Zedu; an organisation's creator is its owner.
enum MembershipRole {
  owner
  admin
  member
}

/// What an agent may do (#427). Each level includes the ones before it.
/// What an agent may do. A ladder: every agent is `working`; `manager` adds
/// accepting fixes and assigning work; `merger` adds executing Git merges.
/// Both higher classes are granted by an organisation admin.
enum AgentLevel {
  working
  manager
  merger
}

/// How a project's voted steps are decided (#vote-governance): a manager agent
/// acts once the votes reach the threshold (manager), or the vote that crosses
/// the threshold does it (threshold).
enum ProjectGovernance {
  manager
  threshold
}

enum MissionRole {
  admin
  member
  signed_out
}

enum MissionViewport {
  desktop
  mobile_375
}

/// An offered claim becomes active when accepted (#449); either may be
/// released, by the agent, by expiry, or by silence (#438).
enum ClaimStatus {
  offered
  /// Held for plan review on a complex issue (#plan-review): awarded, not yet
  /// active. It becomes active when the agent's owner approves the plan.
  planning
  active
  released
}

/// How hard an issue is (#plan-review), set when the idea is converted and
/// editable until the issue's first bid. Only `complex` goes through plan review.
enum Difficulty {
  easy
  medium
  hard
  complex
}

/// A plan's risk or confidence (#plan-review).
enum PlanScale {
  low
  medium
  high
}

/// The owner's decision on a plan (#plan-review); null while it waits.
enum PlanDecision {
  approved
  sent_back
}

/// A confirmation entry's verdict (#issue-confirmations): the issue is real
/// and not a duplicate, it is not (or is a duplicate), or no opinion.
enum ConfirmationVerdict {
  confirm
  reject
  neutral
}

/// A job review's verdict.
enum ValidationVerdict {
  accept
  reject
}

enum RedesignStatus {
  proposed
  approved
  rejected
  superseded
}

enum ProjectVisibility {
  public
  private
}

enum JoinRequestStatus {
  pending
  accepted
  rejected
}


/// A submission row is pending until enough independent reviewers accept it;
/// any reject vetoes it (#617).
enum JobSubmissionStatus {
  pending
  accepted
  rejected
}

enum PointRole {
  solver
  reporter
  reviewer
  /// Triager awards: 1 pt for a not-a-duplicate clearance, 5 for marking a duplicate.
  triager
  /// Paid to the submitter's owner when a research job row is accepted (#617).
  submission
  dispatcher
  /// 1 pt for a person's first opinion on an idea: a validation or a comment.
  idea
  /// The signup bonus, paid once per account in the first organisation it joins or creates.
  signup
  /// 1 pt to a comment's author for each upvote from another person (#comment-votes).
  comment
  /// Paid to the planning agent's owner when the owner approves its plan (#plan-review).
  plan
  /// 1 pt for a person's first importance mark, and first bid vote, on an issue (#vote-points).
  vote
}

enum DisputeStatus {
  open
  granted
  rejected
}

enum WebhookDeliveryStatus {
  pending
  delivered
  failed
  /// Out of retries (#445). The poll feed still has the event.
  dead
}

/// Light or dark appearance (#277). "system" follows the device.
enum ThemePreference {
  system
  light
  dark
}

/// A goal's lifecycle (#616). Only `active` goals accept new splits.
enum GoalStatus {
  active
  completed
  cancelled
}

/// How a split computed each slice of a goal's budget pool (#616).
enum GoalSplitMethod {
  /// Every target named its own amount.
  manual
  /// Amounts follow the targets' weights, largest-remainder rounding.
  proportional
  /// Targets carry percentage shares that must total exactly 100.
  milestone
  /// Every target gets an equal slice; the remainder spreads from the front.
  even
}

/// What one allocation points at (#616): an issue, a nested goal, or an
/// agent deliverable.
enum GoalAllocationTarget {
  issue
  goal
  agent
}

model User {
  featurePlans              FeaturePlan[]
  savedIssueViews           SavedIssueView[]
  id                        String                  @id @default(cuid())
  name                      String
  email                     String                  @unique
  /// Null for Google-only accounts; required for credentials login/signup.
  passwordHash              String?
  emailVerified             DateTime?
  image                     String?
  role                      Role                    @default(user)
  /// #277: stored per user so the choice follows them to every device.
  theme                     ThemePreference         @default(system)
  /// Email when mentioned, assigned, or when an issue you reported changes status (#151).
  /// Master switch. The notify* flags below pick which kinds when it is on.
  emailNotifications        Boolean                 @default(true)
  notifyMentions            Boolean                 @default(true)
  notifyAssignments         Boolean                 @default(true)
  notifyStatusChanges       Boolean                 @default(true)
  /// #287: site-wide keyboard shortcuts; per user so it follows them.
  keyboardShortcuts         Boolean                 @default(true)
  /// #618: optional EVM address (0x + 40 hex) points could later be sent to.
  /// Set only by the person themselves; read only by them and organisation admins.
  walletAddress             String?
  /// #earnings: what the person wants to earn each week, set on Your earnings. Null: the default goal.
  weeklyEarningsGoal        Decimal?                @db.Decimal(10, 2)
  /// Bumped on password reset; JWTs carrying an older value are rejected (#208).
  sessionVersion            Int                     @default(0)
  createdAt                 DateTime                @default(now())
  reportedBugs              Bug[]                   @relation("BugReporter")
  assignedBugs              Bug[]                   @relation("BugAssignee")
  attachments               Attachment[]
  comments                  Comment[]
  votes                     Vote[]
  activities                BugActivity[]
  bugRevisions              BugRevision[]
  passwordResetTokens       PasswordResetToken[]
  totpCredential            TotpCredential?
  totpBackupCodes           TotpBackupCode[]
  securityEvents            SecurityAuditEvent[]
  watches                   IssueWatch[]
  notifications             Notification[]
  // Agent platform (#423).
  memberships               Membership[]
  agents                    Agent[]
  agentPairingsApproved     AgentPairing[]
  agentPreferences          AgentPreference[]
  beneficiaryBugs           Bug[]                   @relation("BugBeneficiary")
  claims                    IssueClaim[]
  dispatchedClaims          IssueClaim[]            @relation("ClaimDispatcher")
  issueBids                 IssueBid[]              @relation("IssueBidBeneficiary")
  deliveries                Delivery[]              @relation("DeliveryBeneficiary")
  plansOwned                Plan[]                  @relation("PlanOwner")
  confirmations             IssueConfirmation[]
  testVerdicts              TestVerdict[]
  mergeReviews              MergeReview[]           @relation("MergeReviewOnBehalfOf")
  pullRequestReports        PullRequestReport[]     @relation("PullRequestReportOnBehalfOf")
  reviewOffers              ReviewOffer[]
  redesignsOnBehalf         RedesignProposal[]      @relation("RedesignOnBehalfOf")
  redesignsApproved         RedesignProposal[]      @relation("RedesignApprover")
  pointEntries              PointEntry[]
  pointDisputes             PointDispute[]          @relation("DisputeOpener")
  pointDisputesResolved     PointDispute[]          @relation("DisputeResolver")
  auditActions              AgentAuditEvent[]       @relation("AuditActorUser")
  agentQuestions            AgentQuestion[]
  agentMessagesSent         AgentMessage[]
  organisationInvitesSent         OrganisationInvite[]
  membershipChangesMade     MembershipChange[]      @relation("MembershipChangeActor")
  membershipChangesReceived MembershipChange[]      @relation("MembershipChangeTarget")
  shareLinksSent            OrganisationShareLink[]
  shareRedemptions          OrganisationShareRedemption[]
  projectAuditEvents        ProjectAuditEvent[]
  jobsCreated               Job[]                   @relation("JobCreator")
  goalsCreated              Goal[]                  @relation("GoalCreator")
  jobSubmissions            JobSubmission[]         @relation("JobSubmissionBeneficiary")
  jobReviews                JobReview[]             @relation("JobReviewBeneficiary")
  jobReviewOffers           JobReviewOffer[]        @relation("JobReviewOfferBeneficiary")
  ideaVerdicts              IdeaVerdict[]           @relation("IdeaVerdictsGiven")
  abandonVotes              AbandonVote[]           @relation("AbandonVotesGiven")
  bidVotes                  BidVote[]               @relation("BidVotesGiven")
  commentVotes              CommentVote[]           @relation("CommentVotesGiven")
  closeSuggestions          CloseSuggestion[]       @relation("CloseSuggestionsGiven")
  reportedIdeas             Idea[]                  @relation("IdeaReporter")
  beneficiaryIdeas          Idea[]                  @relation("IdeaBeneficiary")
  requestedSupportThreads   SupportThread[]         @relation("SupportThreadRequester")
  threadMessages            ThreadMessage[]         @relation("ThreadMessageAuthor")
  projectMemberships        ProjectMembership[]
  projectJoinRequests       ProjectJoinRequest[]
  projectJoinRequestsReviewed ProjectJoinRequest[]  @relation("JoinRequestReviewer")
  skillSubmissions          SkillSubmission[]       @relation("SkillSubmissionSubmittedBy")
  reviewedSkillSubmissions  SkillSubmission[]       @relation("SkillSubmissionReviewedBy")
}

/// Single-use password reset tokens (~30 min TTL). Store only the SHA-256 hash.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model IssueType {
  id          String    @id @default(cuid())
  organisationId    String
  organisation      Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name        String
  description String?
  /// Markdown that pre-fills the report form's description (#307). Null: none.
  template    String?
  isActive    Boolean   @default(true)
  /// Marketing types show only in the Marketing section.
  track       WorkTrack @default(product)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bugs        Bug[]
  ideas       Idea[]

  @@unique([organisationId, name])
  @@unique([id, organisationId])
  @@index([organisationId])
}

model Bug {
  featurePlanItems          FeaturePlanItem[]
  pullRequestLinkRepairs    PullRequestLinkRepair[]
  id                        String                  @id @default(cuid())
  /// Human-readable reference (#1, #2, ...), counted per organisation (#517). The
  /// database trigger `Bug_assign_organisation_number` replaces the sequence value
  /// with `Organisation.nextIssueNumber`, so each organisation starts at #1.
  number                    Int                     @default(autoincrement())
  title                     String
  /// The idea's short summary, carried over when it is converted.
  summary                   String?
  description               String
  status                    Status                  @default(open)
  substatus                 Substatus               @default(requires_confirmation)
  /// How hard it is (#plan-review): set at conversion, editable until the first
  /// bid. Only a complex issue's award goes through plan review.
  difficulty                Difficulty              @default(medium)
  /// Why a closed issue was closed (#close-reasons): superseded,
  /// not_reproducible, already_implemented, duplicate, not_planned or
  /// withdrawn (lib/close-reasons.ts). Null when it is not closed.
  closeReason               String?
  /// The evidence recorded with the close (#close-reasons).
  closeEvidence             String?
  /// When it was last closed (#close-reasons); null while it is not closed.
  closedAt                  DateTime?
  /// When the issue's owner said they agree with the close other members voted for (#your-decisions).
  closeAgreedAt             DateTime?
  typeId                    String?
  type                      IssueType?              @relation(fields: [typeId], references: [id], onDelete: SetNull)
  /// The issue's importance (#importance): its marks, a manager or merger agent's counting as 5.
  voteCount                 Int                     @default(0)
  isBoosted                 Boolean                 @default(false)
  boostedAt                 DateTime?
  /// #289: at most one milestone. Cleared, not cascaded, when it's deleted.
  milestoneId               String?
  milestone                 Milestone?              @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  isDeleted                 Boolean                 @default(false)
  deletedAt                 DateTime?
  proofLinks                String[]                @default([])
  reporterId                String
  assigneeId                String?
  /// #285: set when this issue is a duplicate of another. One level only:
  /// the target is never itself a duplicate (enforced in the action).
  duplicateOfId             String?
  duplicateOf               Bug?                    @relation("BugDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates                Bug[]                   @relation("BugDuplicates")
  blockedBy                 IssueBlocker[]          @relation("IssueBlockedBy")
  blocking                  IssueBlocker[]          @relation("IssueBlocking")
  /// Product or marketing work (`WorkTrack`).
  track                     WorkTrack               @default(product)
  /// How many times this marketing work has been sent back for changes on the
  /// same claim, up to `ProjectWorkflow.revisionLimit`. Not the edit history (`revisions`).
  revisionCount             Int                     @default(0)
  /// The product issue this marketing issue goes with, if any. Optional: a
  /// marketing issue can stand alone. Same project, enforced where it is set.
  linkedIssueId             String?
  linkedIssue               Bug?                    @relation("BugLinkedIssue", fields: [linkedIssueId], references: [id], onDelete: SetNull)
  linkedMarketingIssues     Bug[]                   @relation("BugLinkedIssue")
  /// #423: every issue belongs to an organisation and one of its projects.
  organisationId                  String
  organisation                    Organisation                  @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  projectId                 String
  project                   Project                 @relation(fields: [projectId], references: [id], onDelete: Restrict)
  areaId                    String?
  area                      ProjectArea?            @relation(fields: [areaId], references: [id], onDelete: SetNull)
  /// #423: the person the work is for. The reporter unless an agent filed it
  /// for someone else; points go to this person, never to the agent.
  beneficiaryUserId         String
  beneficiary               User                    @relation("BugBeneficiary", fields: [beneficiaryUserId], references: [id])
  /// #423: set when an agent filed the issue. Null for people.
  createdByAgentId          String?
  createdByAgent            Agent?                  @relation("AgentCreatedBugs", fields: [createdByAgentId], references: [id], onDelete: SetNull)
  /// #452: the pull request that fixes this issue, if one is linked.
  pullRequestUrl            String?
  /// Head commit of that pull request when it was linked (#489). Acceptance
  /// and the merge gate bind to this exact commit, not just the PR number.
  pullRequestHeadSha        String?
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  reporter                  User                    @relation("BugReporter", fields: [reporterId], references: [id])
  assignee                  User?                   @relation("BugAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  attachments               Attachment[]
  comments                  Comment[]
  votes                     Vote[]
  watches                   IssueWatch[]
  notifications             Notification[]
  activities                BugActivity[]
  revisions                 BugRevision[]
  claims                    IssueClaim[]
  abandonVotes              AbandonVote[]
  bidVotes                  BidVote[]
  commentVotes              CommentVote[]
  closeSuggestions          CloseSuggestion[]       @relation("CloseSuggestions")
  /// Close suggestions saying this issue owns the work another duplicates (#close-reasons).
  duplicateCloseSuggestions CloseSuggestion[]       @relation("CloseSuggestionDuplicateOf")
  /// What solving it pays, in $ (#rewards): the average of agents' estimates, $1–$10; $1 until the first.
  reward                    Decimal                 @default(1) @db.Decimal(6, 2)
  /// How many estimates the reward averages; at 15 it is fixed.
  rewardEstimateCount       Int                     @default(0)
  rewardFixedAt             DateTime?
  rewardEstimates           RewardEstimate[]
  /// What resolving it earned, held until enough agents report it deployed (#live-payout).
  heldPayout                Json?
  /// When the held payout was paid.
  payoutReleasedAt          DateTime?
  deploymentReports         DeploymentReport[]
  stakes                    IssueStake[]
  bids                      IssueBid[]
  deliveries                Delivery[]
  plans                     Plan[]
  confirmations             IssueConfirmation[]
  /// The idea this issue was converted from (#idea-table). Every issue starts as one.
  idea                      Idea?
  testVerdicts              TestVerdict[]
  mergeReviews              MergeReview[]
  pullRequestReports        PullRequestReport[]
  reviewOffers              ReviewOffer[]
  redesigns                 RedesignProposal[]
  pointEntries              PointEntry[]
  pointDisputes             PointDispute[]
  agentQuestions            AgentQuestion[]
  idempotencyKeys           IdempotencyKey[]
  agentEvents               AgentEvent[]
  auditEvents               AgentAuditEvent[]
  goalAllocations           GoalAllocation[]
  mistakes                  AgentMistake[]
  supportThreads            SupportThread[]

  /// #517: issue numbers are per organisation, so two organisations can both have a #1.
  @@unique([organisationId, number])
  @@index([organisationId, projectId])
  @@index([organisationId, projectId, substatus])
  @@index([projectId, track, status])
  @@index([linkedIssueId])
  @@index([projectId, areaId])
  @@index([beneficiaryUserId])
  @@index([createdByAgentId])
  @@index([typeId])
  @@index([duplicateOfId])
  @@index([isBoosted])
  @@index([isDeleted])
  @@index([milestoneId])
  // #217: foreign keys behind the "Assigned to me" / "Reported by me" filters.
  @@index([assigneeId])
  @@index([reporterId])
  // #217: match getBugOrderBy() exactly (boosted first, then the chosen sort),
  // so the list can be read in index order instead of sorting every row.
  @@index([isDeleted, isBoosted(sort: Desc), boostedAt(sort: Desc), voteCount(sort: Desc), updatedAt(sort: Desc), createdAt(sort: Desc)], map: "Bug_list_top_votes_idx")
  @@index([isDeleted, isBoosted(sort: Desc), boostedAt(sort: Desc), createdAt(sort: Desc), id(sort: Desc)], map: "Bug_list_newest_idx")
}

/// A dependency that explains why an issue cannot proceed until another issue is resolved.
model IssueBlocker {
  id           String   @id @default(cuid())
  blockedBugId String
  blockerBugId String
  createdAt    DateTime @default(now())
  blockedBug   Bug      @relation("IssueBlockedBy", fields: [blockedBugId], references: [id], onDelete: Cascade)
  blockerBug   Bug      @relation("IssueBlocking", fields: [blockerBugId], references: [id], onDelete: Cascade)

  @@unique([blockedBugId, blockerBugId])
  @@index([blockerBugId])
}

/// A platform (Desktop, Web, Mobile) inside one organisation.
/// The same name can exist in another organisation; it is a different platform.
/// A platform (#platforms): Desktop, Web, Mobile and any the organisation adds.
/// Agents name it by `slug`; issues and ideas carry it as `platform`.

/// A release or sprint grouping issues (#289).
model Milestone {
  id          String    @id @default(cuid())
  organisationId    String
  organisation      Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  title       String
  description String?
  /// A calendar day; no time of day.
  dueDate     DateTime? @db.Date
  /// Closing a milestone leaves its issues alone.
  isClosed    Boolean   @default(false)
  closedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bugs        Bug[]

  @@unique([organisationId, title])
  @@unique([id, organisationId])
  @@index([organisationId])
  @@index([isClosed, dueDate])
}

model BugActivity {
  id        String       @id @default(cuid())
  bugId     String
  actorId   String
  type      ActivityType
  summary   String
  metadata  Json?
  createdAt DateTime     @default(now())
  bug       Bug          @relation(fields: [bugId], references: [id], onDelete: Cascade)
  actor     User         @relation(fields: [actorId], references: [id])

  @@index([bugId, createdAt])
}

/// A title + description an edit replaced (#303). The issue row holds the
/// current version; these are the ones before it.
model BugRevision {
  id          String   @id @default(cuid())
  bugId       String
  title       String
  description String
  /// Who made the edit that replaced this version. Null if since deleted.
  editedById  String?
  editedAt    DateTime @default(now())
  bug         Bug      @relation(fields: [bugId], references: [id], onDelete: Cascade)
  editedBy    User?    @relation(fields: [editedById], references: [id], onDelete: SetNull)

  @@index([bugId, editedAt])
}

/// A plain reply to one stage entry (#entry-replies-only): exactly one of
/// confirmationId, bidId, testVerdictId or mergeReviewId is set on a new one.
/// Comments with none are from before; they show read-only as earlier comments.
model Comment {
  id          String        @id @default(cuid())
  bugId       String
  authorId    String
  parentId    String?
  /// The point in at most two sentences, shown above the body (#730). Agents
  /// give one with every comment; people's comments and older ones have none.
  summary     String?
  /// A short freeform label an agent gives its comment (under 30 characters),
  /// shown in the comment's title, e.g. "Blocker" or "Root cause".
  label       String?
  body        String
  createdAt   DateTime      @default(now())
  /// Set when the author edits the comment; shown as "edited".
  editedAt    DateTime?
  /// Soft delete: the body is cleared and replies keep their place.
  deletedAt   DateTime?
  /// #423: the agent that wrote it for `authorId`. Null for people.
  agentId     String?
  agent       Agent?        @relation(fields: [agentId], references: [id], onDelete: SetNull)
  bug         Bug           @relation(fields: [bugId], references: [id], onDelete: Cascade)
  author      User          @relation(fields: [authorId], references: [id])
  parent      Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[]     @relation("CommentReplies")
  attachments Attachment[]
  votes       CommentVote[]

  ideaVerdict    IdeaVerdict?
  /// Set on a reply to a confirmation entry (#issue-confirmations).
  confirmationId String?
  confirmation   IssueConfirmation? @relation(fields: [confirmationId], references: [id], onDelete: Cascade)
  /// Set on a reply to a bid (#issue-bids).
  bidId          String?
  bid            IssueBid?          @relation(fields: [bidId], references: [id], onDelete: Cascade)
  /// Set on a reply to a delivery (#delivered-step).
  deliveryId     String?
  delivery       Delivery?          @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  /// Set on a reply to a test verdict (#review-entries).
  testVerdictId  String?
  testVerdict    TestVerdict?       @relation(fields: [testVerdictId], references: [id], onDelete: Cascade)
  /// Set on a reply to a merge review (#review-entries).
  mergeReviewId  String?
  mergeReview    MergeReview?       @relation(fields: [mergeReviewId], references: [id], onDelete: Cascade)
  /// Set on a reply to a plan (#plan-review).
  planId         String?
  plan           Plan?              @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([bugId])
  @@index([bugId, createdAt])
  @@index([parentId])
  @@index([confirmationId])
  @@index([bidId])
  @@index([deliveryId])
  @@index([testVerdictId])
  @@index([mergeReviewId])
  @@index([planId])
}

/// Files attached to an issue or a comment (#215): screenshots, logs, PDFs,
/// HAR files. Stored in Postgres (max 5 MB, checked in lib/attachments.ts)
/// and only served to signed-in users. Uploaded first, then linked to the
/// issue or comment when it's saved; until then only the uploader can see it.
model Attachment {
  id                 String             @id @default(cuid())
  uploaderId         String
  bugId              String?
  commentId          String?
  /// Evidence on a confirmation entry (#confirmation-evidence).
  confirmationId     String?
  redesignProposalId String?
  filename           String
  contentType        String
  size               Int
  data               Bytes
  createdAt          DateTime           @default(now())
  uploader           User               @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  bug                Bug?               @relation(fields: [bugId], references: [id], onDelete: Cascade)
  /// Set on an idea's attachments (#idea-table). Converting the idea also sets `bugId`.
  ideaId             String?
  idea               Idea?              @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  comment            Comment?           @relation(fields: [commentId], references: [id], onDelete: Cascade)
  confirmation       IssueConfirmation? @relation(fields: [confirmationId], references: [id], onDelete: Cascade)
  redesignProposal   RedesignProposal?  @relation(fields: [redesignProposalId], references: [id], onDelete: Cascade)

  @@index([bugId])
  @@index([ideaId])
  @@index([commentId])
  @@index([confirmationId])
  @@index([redesignProposalId])
  @@index([uploaderId, createdAt])
}

/// One person marking an issue important (#importance; once "upvotes").
/// The DB keeps the old names: `Vote` here and `Bug.voteCount` for the total.
/// A person's click in the app is a plain toggle. An agent marking it for its
/// owner must say why: `agentId`, `summary` and `description` are set, and
/// marking it again replaces the reason.
model Vote {
  id        String   @id @default(cuid())
  userId    String
  bugId     String
  value     Int      @default(1)
  /// The agent that marked it for `userId`, or null for a person's own click.
  agentId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bug       Bug      @relation(fields: [bugId], references: [id], onDelete: Cascade)
  agent     Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@unique([userId, bugId])
  @@index([bugId])
  @@index([agentId])
}

/// Who follows an issue (#216). People are watching by default when they
/// report, are assigned to or comment on an issue; `watching = false` records
/// an explicit "Unwatch" so they aren't added back automatically.
model IssueWatch {
  userId    String
  bugId     String
  watching  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bug       Bug      @relation(fields: [bugId], references: [id], onDelete: Cascade)

  @@id([userId, bugId])
  @@index([bugId])
}

/// In-app notification feed (#216): one row per person per event, written
/// whether or not email is configured or wanted.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  organisationId  String?
  bugId     String?
  /// Event kind, e.g. "comment_added", "mentioned", "status_changed".
  kind      String
  title     String
  /// App-relative link, e.g. /bugs/<id>#comment-<id>.
  url       String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation    Organisation?   @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  bug       Bug?      @relation(fields: [bugId], references: [id], onDelete: SetNull)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([userId, organisationId, readAt])
}

/// Sliding-window rate-limit attempts, shared by every app instance (#296).
/// `key` is a SHA-256 of the limiter key (it contains emails and IPs); `at`
/// is epoch milliseconds. Rows older than the longest window are deleted.
model RateLimitHit {
  id  BigInt @id @default(autoincrement())
  key String
  at  BigInt

  @@index([key, at])
}

// ---------------------------------------------------------------------------
// Agent platform (#422, #423). People and their agents work the same issues
// inside an organisation. This block is owned by #423: later platform issues add
// files, not columns.
// ---------------------------------------------------------------------------

/// An organisation on Ziki. Zedu is the first.
model Organisation {
  id                 String              @id @default(cuid())
  slug               String              @unique
  name               String
  description        String?             @db.VarChar(500)
  /// Set when an owner archives the organisation (#573). Archived organisations are
  /// hidden from the switcher and cannot be selected.
  archivedAt         DateTime?
  /// #517: the next issue number this organisation hands out. The insert trigger
  /// increments it under a row lock, so concurrent creates stay unique.
  nextIssueNumber    Int                 @default(1)
  /// The next idea number this organisation hands out (#idea-table). Ideas are numbered apart from issues.
  nextIdeaNumber     Int                 @default(1)
  /// What every award in this organisation is multiplied by when it is written (#points-multiplier). 1 is normal.
  pointsMultiplier   Decimal             @default(1) @db.Decimal(8, 2)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  projects           Project[]
  issueTypes         IssueType[]
  milestones         Milestone[]
  memberships        Membership[]
  agentActivations   AgentActivation[]
  agentApiKeys       AgentApiKey[]
  skillTags          SkillTag[]
  bugs               Bug[]
  ideas              Idea[]
  auditEvents        AgentAuditEvent[]
  redesigns          RedesignProposal[]
  pointEntries       PointEntry[]
  pointDisputes      PointDispute[]
  invites            OrganisationInvite[]
  shareLinks         OrganisationShareLink[]
  events             AgentEvent[]
  membershipChanges  MembershipChange[]
  notifications      Notification[]
  projectAuditEvents ProjectAuditEvent[]
  jobs               Job[]
  goals              Goal[]
  supportThreads     SupportThread[]
}

/// A project inside an organisation (organisation), e.g. Zedu Web or Zedu Desktop.
/// Organisations hold projects and nothing in between (#no-platforms).
model Project {
  featurePlans          FeaturePlan[]
  savedIssueViews        SavedIssueView[]
  agentNotes            AgentNote[]
  id                    String                @id @default(cuid())
  organisationId              String
  slug                  String
  name                  String
  /// What the project is for, shown to agents (#437).
  goal                  String?
  repoUrl               String?
  /// The product's live site (#project-links): what the project builds, for people and agents.
  siteUrl               String?
  stagingUrl            String?
  /// GitHub App installation used to merge accepted fixes (#452). Never a token.
  githubInstallationId  String?
  /// Set when an organisation owner archives the project (#573). Archived projects
  /// are hidden from the switcher and cannot be selected.
  archivedAt            DateTime?
  /// Deprecated (#595): the delivery window now lives on ProjectWorkflow.
  /// Kept for rollback safety; application code no longer reads or writes it.
  deliveryWindowMinutes Int                   @default(15)
  /// How long a claim may wait on its agent's owner before it is released (#606).
  ownerWaitCapMinutes   Int                   @default(240)
  /// Custom points and rewards configuration for this project (#741).
  rewardConfig          Json?
  /// Public projects are discoverable by anyone; private projects require membership (#project-discovery).
  visibility            ProjectVisibility     @default(private)
  /// Whether the project is open for external contributors to apply to join.
  isOpenForContributors Boolean               @default(false)
  /// Optional guidelines shown to applicants when requesting to join.
  contributorGuidelines String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  organisation                Organisation                @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  bugs                  Bug[]
  ideas                 Idea[]
  areas                 ProjectArea[]
  redesigns             RedesignProposal[]
  testMissions          TestMission[]
  auditEvents           ProjectAuditEvent[]
  jobs                  Job[]
  agentEvents           AgentEvent[]
  goals                 Goal[]
  workflow              ProjectWorkflow?
  mistakes              AgentMistake[]
  notes                 ProjectNotes?
  brief                 ProjectBrief?
  noteRevisions         ProjectNoteRevision[]
  noteComments          ProjectNoteComment[]
  memberships           ProjectMembership[]
  joinRequests          ProjectJoinRequest[]
  repositories          ProjectRepository[]

  @@unique([organisationId, slug])
}

/// More GitHub repositories for a project (#2), e.g. its API next to its web app.
/// `Project.repoUrl` stays the main repository; these are the others. A pull
/// request in any of them can be linked, delivered, accepted and resolved.
model ProjectRepository {
  id                   String   @id @default(cuid())
  projectId            String
  /// `https://github.com/owner/repo`, lower-cased so a repository is listed once.
  url                  String
  /// Short name shown to people and agents, e.g. "API" or "Mobile".
  label                String?
  /// The branch fixes go into, when it isn't the repository's default. Shown to
  /// people and agents; Ziki does not read GitHub to enforce it (#pr-reports).
  branch               String?
  /// GitHub App installation for this repository when it differs from the
  /// project's (another organization). Never a token.
  githubInstallationId String?
  createdAt            DateTime @default(now())
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, url])
  @@index([projectId])
}

/// The per-project workflow dials (#595). One row per project; a missing row
/// falls back to the defaults in lib/workflow-config.ts.
model ProjectWorkflow {
  projectId              String            @id
  confirmationsNeeded    Int               @default(3)
  verdictsNeeded         Int               @default(3)
  offerWindowSeconds     Int               @default(1800)
  heartbeatMinutes       Int               @default(240)
  deliveryMinutes        Int               @default(240)
  maxActiveClaims        Int               @default(10)
  volunteerWindowSeconds Int               @default(120)
  autoMerge              Boolean           @default(true)
  /// Net idea votes (good minus bad) before a manager agent may convert an idea to an issue.
  ideaThreshold          Int               @default(3)
  /// Minutes without an update before in-progress work is put up for a sense check (#abandon).
  abandonCheckMinutes    Int               @default(120)
  /// Abandoned votes that take in-progress work back to Open (a manager agent's vote counts managerVoteWeight).
  abandonThreshold       Int               @default(3)
  /// Close-suggestion votes for one reason (each reason tallied apart) that put an issue in the managers' queue to close, or in a threshold-only project close it (#close-reasons).
  closeThreshold         Int               @default(3)
  /// Who acts when a step's votes reach its threshold: a manager agent (manager), or the deciding vote itself (threshold) (#vote-governance).
  governance             ProjectGovernance @default(manager)
  /// What a manager or merger agent's vote counts in a weighted tally; a person's or a working agent's counts 1.
  managerVoteWeight      Int               @default(3)
  /// Weighted bid votes that award a bid, in a threshold-only project.
  awardThreshold         Int               @default(3)
  /// Weighted merge reviews (accepts, or rejects) that decide a Done issue, in a threshold-only project.
  acceptThreshold        Int               @default(3)
  /// Open stakes (on ideas and issues together) one person's agents may hold at once (#stakes).
  stakeLimit             Int               @default(2)
  /// No new stake while the person holds this many issues In progress (#stakes).
  stakeInProgressLimit   Int               @default(2)
  /// Times marketing work can be sent back to the same claim before it reopens for bids.
  revisionLimit          Int               @default(2)
  /// How long a complex issue's award has for the plan to be written and approved (#plan-review); restarts on a send-back.
  planReviewSeconds      Int               @default(7200)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  project                Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

/// A project-owned work area, such as frontend or backend (#609).
model ProjectArea {
  id               String                @id @default(cuid())
  projectId        String
  name             String
  slug             String
  description      String?
  paths            String[]              @default([])
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  project          Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  bugs             Bug[]
  ideas            Idea[]
  agentPreferences AgentAreaPreference[]

  @@unique([projectId, slug])
  @@index([projectId])
}

/// An agent's preferred areas for a project. Preference never restricts access.
model AgentAreaPreference {
  agentId       String
  projectAreaId String
  createdAt     DateTime    @default(now())
  agent         Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  projectArea   ProjectArea @relation(fields: [projectAreaId], references: [id], onDelete: Cascade)

  @@id([agentId, projectAreaId])
  @@index([projectAreaId])
}

/// A route, role, and viewport slice for exploratory testing (#619).
model TestMission {
  id                  String          @id @default(cuid())
  projectId           String
  routePattern        String
  brief               String
  role                MissionRole
  viewport            MissionViewport
  lastCoveredAt       DateTime?
  issuesFiled         Int             @default(0)
  lastAssignedAt      DateTime?
  lastAssignedOwnerId String?
  leaseAgentId        String?
  leaseOwnerId        String?
  leaseExpiresAt      DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  project             Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, routePattern, role, viewport])
  @@index([projectId, lastCoveredAt, lastAssignedAt])
  @@index([leaseAgentId, leaseExpiresAt])
}

/// A password account's TOTP second factor (#648). The secret is sealed
/// (AES-256-GCM, lib/secret-box.ts). Until `enabledAt` is set the secret is
/// only a pending enrolment and sign-in does not ask for a code.
model TotpCredential {
  userId       String    @id
  secret       String
  enabledAt    DateTime?
  /// The 30-second step of the last code accepted, so a code works once.
  lastUsedStep Int?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Single-use recovery codes. Only a keyed hash is stored; the codes are
/// shown once, when they are made.
model TotpBackupCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@index([userId, usedAt])
}

/// Changes to how a person signs in: second factor on or off, codes made or used.
model SecurityAuditEvent {
  id        String   @id @default(cuid())
  userId    String
  type      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Human changes to project configuration, including GitHub App linking.
model ProjectAuditEvent {
  id          String   @id @default(cuid())
  organisationId    String
  projectId   String
  actorUserId String
  action      String
  changes     Json
  createdAt   DateTime @default(now())
  organisation      Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([organisationId, createdAt])
  @@index([projectId, createdAt])
  @@index([actorUserId, createdAt])
}

model Membership {
  id        String         @id @default(cuid())
  organisationId  String
  userId    String
  role      MembershipRole @default(member)
  createdAt DateTime       @default(now())
  organisation    Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organisationId, userId])
  @@index([userId])
}

/// A change to who is in an organisation and what they can do there.
/// Site-wide User.role is not this: an admin of one organisation is a member of another.
model MembershipChange {
  id           String          @id @default(cuid())
  organisationId     String
  actorUserId  String?
  targetUserId String?
  /// "role_changed", "removed", or "left".
  action       String
  fromRole     MembershipRole?
  toRole       MembershipRole?
  createdAt    DateTime        @default(now())
  organisation       Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  actor        User?           @relation("MembershipChangeActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  target       User?           @relation("MembershipChangeTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([organisationId, createdAt])
}

/// Direct membership in a project, for external contributors who are not members of the parent organisation.
model ProjectMembership {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId])
}

/// An application from a user to join an open project.
model ProjectJoinRequest {
  id         String            @id @default(cuid())
  projectId  String
  userId     String
  message    String?           @db.VarChar(1000)
  status     JoinRequestStatus @default(pending)
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewer   User?             @relation("JoinRequestReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@unique([projectId, userId])
  @@index([projectId, status])
  @@index([userId])
}

/// A named agent working for its owner inside an organisation (#427). It always acts
/// as itself and for a named person.
model Agent {
  requests             AgentRequest[]
  agentNotes           AgentNote[]
  id                   String                @id @default(cuid())
  ownerUserId          String
  /// Display name, e.g. "Larry's Claude".
  name                 String
  /// The model behind it, e.g. "Claude" or "GPT". Not the display name.
  model                String?
  revokedAt            DateTime?
  /// Owner has paused this agent; active claim clocks are frozen until resumed.
  pausedAt             DateTime?
  /// The owner's standing brief (#605), returned by `GET /api/v1/agents/me`.
  instructions         String?
  /// The robot avatar its owner picked, a key from lib/agents/avatars.ts.
  /// Null means the automatic one drawn from the agent's id.
  avatar               String?
  /// Global standing (#agent-reputation): down for each penalty on its confirmations, up for each upvote on its comments.
  reputation           Int                   @default(0)
  /// Its handle and slug (#agent-profile): shown as @username and the address of
  /// its public page, /agent/{username}. Lowercase letters, digits and dashes,
  /// unique across the platform. Never empty: a database trigger gives an agent
  /// created without one a default from its name, with -2, -3, … on a clash.
  username             String                @unique @default(dbgenerated())
  /// One line on what it does (#agent-profile), at most AGENT_TAGLINE_MAX characters.
  tagline              String?
  /// "About me" (#agent-profile): what it is good at and how it works, at most AGENT_ABOUT_MAX characters.
  about                String?
  /// "What I can do for you" (#agent-profile): what it offers the people it works with, at most AGENT_SERVICES_MAX characters.
  services             String?
  /// Its rating out of 5 (#agent-profile), from the reviews of its delivered work; null until it has any.
  rating               Float?
  /// What it is good at (#agent-profile), each under a tag the organisation shares.
  skills               AgentSkill[]
  /// Its profile picture (#agent-profile), uploaded by the agent; none shows its avatar.
  picture              AgentPicture?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  owner                User                  @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  areaPreferences      AgentAreaPreference[]
  apiKeys              AgentApiKey[]
  /// Where it works (#user-agents): one activation per organisation, each with that organisation's grants.
  activations          AgentActivation[]
  auditEvents          AgentAuditEvent[]
  createdBugs          Bug[]                 @relation("AgentCreatedBugs")
  createdIdeas         Idea[]                @relation("AgentCreatedIdeas")
  comments             Comment[]
  claims               IssueClaim[]
  bids                 IssueBid[]
  deliveries           Delivery[]
  plans                Plan[]
  confirmations        IssueConfirmation[]
  testVerdicts         TestVerdict[]
  mergeReviews         MergeReview[]
  pullRequestReports   PullRequestReport[]
  reviewOffers         ReviewOffer[]
  redesigns            RedesignProposal[]
  questions            AgentQuestion[]
  messages             AgentMessage[]
  idempotencyKeys      IdempotencyKey[]
  events               AgentEvent[]
  webhookSubscriptions WebhookSubscription[]
  jobSubmissions       JobSubmission[]
  jobReviews           JobReview[]
  jobReviewOffers      JobReviewOffer[]
  inboxItems           AgentInboxItem[]
  goalAllocations      GoalAllocation[]
  recordedMistakes     AgentMistake[]

  ideaVerdicts      IdeaVerdict[]
  abandonVotes      AbandonVote[]
  bidVotes          BidVote[]
  commentVotes      CommentVote[]
  pointEntries      PointEntry[]
  closeSuggestions  CloseSuggestion[]
  importanceMarks   Vote[]
  stakes            IssueStake[]
  penaltiesGiven    ConfirmationPenalty[] @relation("PenaltiesGiven")
  penaltiesReceived ConfirmationPenalty[] @relation("PenaltiesReceived")
  assignedSupportThreads SupportThread[]  @relation("SupportThreadAssignee")
  threadMessages         ThreadMessage[]  @relation("ThreadMessageAgent")

  @@index([ownerUserId])
}

/// A one-way hash of the key is always stored. The raw key is shown once,
/// except a person's personal project key, which is also sealed so they can copy it.
/// An agent switched on in one organisation (#user-agents). A person owns their
/// agents once; every organisation they belong to may use them all, and they
/// choose which to activate where. An agent works in every project of an
/// organisation it is active in. The organisation's grants live here: its
/// class (an organisation admin's grant) and its rate budget.
model AgentActivation {
  id             String       @id @default(cuid())
  agentId        String
  organisationId String
  level          AgentLevel   @default(working)
  /// When the class last changed: the manager/merger review cooling-off reads it.
  levelChangedAt DateTime?
  /// Higher rate budget, set only by an organisation admin (#440).
  burst          Boolean      @default(false)
  /// When the higher budget stops (#596). Null on an enabled grant means it has no expiry.
  burstUntil     DateTime?
  activatedAt    DateTime     @default(now())
  /// Set when its owner switches it off here; its keys for this organisation stop working.
  deactivatedAt  DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  agent          Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([agentId, organisationId])
  @@index([organisationId])
}

model AgentApiKey {
  id         String    @id @default(cuid())
  agentId    String
  /// The organisation this key works in: the activation it belongs to (#user-agents), every project in it.
  organisationId String
  /// SHA-256 of the raw key.
  keyHash    String    @unique
  /// AES-256-GCM of the raw key, so the owner can copy it again from Settings.
  /// Null on keys issued before every agent key was sealed.
  sealedKey  String?
  /// The first characters of the key, so the owner can tell keys apart.
  prefix     String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  agent      Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([agentId, organisationId])
}

/// Pairing an agent by code (#427). The owner is set only when a signed-in
/// member approves the code.
model AgentPairing {
  id                   String      @id @default(cuid())
  /// SHA-256 of the pairing code.
  codeHash             String      @unique
  proposedName         String
  expiresAt            DateTime
  ownerUserId          String?
  /// The organisation the agent joins, set on approval.
  organisationId             String?
  /// The agent row created on approval.
  agentId              String?
  /// SHA-256 of the secret the waiting agent polls with to collect its key.
  deviceCodeHash       String      @unique
  proposedModel        String?
  /// The level the agent asked for at pairing start (#425); owner sees it on approval.
  proposedLevel        AgentLevel?
  /// Standing instructions the agent proposed at pairing start (#431). Only
  /// shown to the owner; the agent gets the text the owner approves.
  proposedInstructions String?
  /// Set when the waiting agent has collected its key; single use.
  consumedAt           DateTime?
  approvedAt           DateTime?
  createdAt            DateTime    @default(now())
  owner                User?       @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

/// Every agent action, so any call can be traced and undone (#427, #450).
model AgentAuditEvent {
  id          String    @id @default(cuid())
  organisationId    String
  agentId     String
  action      String
  /// What the action was on, e.g. "bug:<id>".
  target      String?
  /// The issue, when there is one, so the log can be filtered by it (#447).
  bugId       String?
  /// A person acting on the agent, e.g. an organisation admin's undo (#450) or a
  /// level change (#451). Null when the agent acted.
  actorUserId String?
  payload     Json?
  /// Set by an organisation admin's undo; the row itself is kept.
  undoneAt    DateTime?
  createdAt   DateTime  @default(now())
  organisation      Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  agent       Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  bug         Bug?      @relation(fields: [bugId], references: [id], onDelete: SetNull)
  actorUser   User?     @relation("AuditActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organisationId, createdAt])
  @@index([agentId, createdAt])
  @@index([bugId, createdAt])
  @@index([createdAt])
}

/// An agent working an issue for a person (#432, #438, #449).
model IssueClaim {
  id                  String      @id @default(cuid())
  bugId               String
  beneficiaryUserId   String
  agentId             String
  dispatcherUserId    String?
  status              ClaimStatus @default(active)
  offeredAt           DateTime?
  claimedAt           DateTime?
  lastHeartbeatAt     DateTime?
  /// When the fix is due (#593). Set when an offer or bid becomes active.
  deliverBy           DateTime?
  /// Set when the agent spends its one extension; a second request is refused.
  extendedAt          DateTime?
  /// Why the agent asked for more time, shown in the audit log.
  extensionReason     String?
  /// Set while the agent waits for its owner to answer a question about this
  /// issue (#606). The silence and deadline clocks pause until it clears.
  waitingOnOwnerSince DateTime?
  releasedAt          DateTime?
  /// Why it was released: "silence" (#438), "deadline" (#593), "expired"
  /// (#449), "undo" (#450), "agent", "resolved", "closed", or
  /// "owner_unresponsive" (#606). #451 counts silence and deadline releases.
  releaseReason       String?
  createdAt           DateTime    @default(now())
  bug                 Bug         @relation(fields: [bugId], references: [id], onDelete: Cascade)
  beneficiary         User        @relation(fields: [beneficiaryUserId], references: [id], onDelete: Cascade)
  agent               Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  dispatcher          User?       @relation("ClaimDispatcher", fields: [dispatcherUserId], references: [id], onDelete: SetNull)

  awardedBid   IssueBid?
  abandonVotes AbandonVote[]
  wonStake     IssueStake?
  /// The plan written for this claim's plan review (#plan-review).
  plan         Plan?
  // Enforced by a partial unique index in the migration: one pending offer per issue.
  // Enforced by a partial unique index in the migration: one active claim per issue (#662).

  @@index([dispatcherUserId])
  @@index([bugId, releasedAt])
  @@index([beneficiaryUserId, releasedAt])
  @@index([agentId])
  @@index([deliverBy])
}

/// An agent asking for an open task. A bid does not assign the issue.
/// A person awards one bid, and that award becomes the active claim.
/// One person's estimate of an issue's reward (#rewards): $1 (easy) to $10
/// (expensive). The reward is their average; estimating again replaces yours
/// until the reward is fixed at 15 estimates.
model RewardEstimate {
  id               String   @id @default(cuid())
  bugId            String
  onBehalfOfUserId String
  agentId          String?
  value            Int
  /// Why that much, in a sentence or two.
  reason           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  bug              Bug      @relation(fields: [bugId], references: [id], onDelete: Cascade)

  @@unique([bugId, onBehalfOfUserId])
}

/// One person's report of where a Live issue's work is deployed (#live-payout):
/// the latest per person. Three independent people reporting it deployed
/// release what resolving it earned.
model DeploymentReport {
  id               String   @id @default(cuid())
  bugId            String
  onBehalfOfUserId String
  agentId          String?
  /// dev, staging or prod.
  environment      String
  note             String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  bug              Bug      @relation(fields: [bugId], references: [id], onDelete: Cascade)

  @@unique([bugId, onBehalfOfUserId])
}

/// Where a stake is (#stakes).
enum StakeStatus {
  /// On an idea, waiting for it to become an issue (up to 24 hours).
  waiting
  /// On an issue, its 10-minute window running: it wins unless someone counters.
  open
  /// Countered: the two contenders' stakes go to a vote.
  contested
  /// It won: the agent holds the issue (claimId).
  won
  /// The other contender won, or the issue was taken another way.
  lost
  /// Dropped: no proof of life in time, the idea timed out, or the agent withdrew it.
  dropped
}

/// A stake (#stakes): an agent's fast claim on an idea or an issue, with its
/// plan. Uncontested for 10 minutes on an issue, with a refresh at least every
/// 5 minutes, it wins the issue outright. A counter-stake sends both to a
/// 30-minute vote. On an idea it waits up to 24 hours for the idea to convert.
model IssueStake {
  id                String      @id @default(cuid())
  organisationId          String
  projectId         String
  /// The idea it was placed on, if any; it moves to the issue when the idea converts.
  ideaId            String?
  /// The issue it is on (null while it waits on an idea).
  bugId             String?
  agentId           String
  /// The person it is for: the agent's owner.
  beneficiaryUserId String
  /// At most two sentences: what the agent will do.
  summary           String
  /// The plan in full.
  description       String
  status            StakeStatus @default(open)
  /// Proof of life: the agent refreshes it at least every 5 minutes while it is open or contested.
  lastRefreshAt     DateTime    @default(now())
  /// When an uncontested stake on an issue wins.
  windowEndsAt      DateTime?
  /// When a contest is decided.
  contestEndsAt     DateTime?
  /// When a stake waiting on an idea drops (24 hours after it was placed).
  expiresAt         DateTime?
  resolvedAt        DateTime?
  /// Why it ended: won, outvoted, tie_earlier, no_refresh, idea_timeout, withdrawn, taken, capacity, closed.
  resolution        String?
  /// The claim it won.
  claimId           String?     @unique
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  agent             Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  bug               Bug?        @relation(fields: [bugId], references: [id], onDelete: Cascade)
  idea              Idea?       @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  claim             IssueClaim? @relation(fields: [claimId], references: [id], onDelete: SetNull)
  votes             StakeVote[]

  @@index([bugId, status])
  @@index([ideaId, status])
  @@index([beneficiaryUserId, status])
  @@index([status, windowEndsAt])
}

/// One person's vote in a stake contest (#stakes): for one of the two stakes.
/// Voting again moves it. A manager or merger agent's counts managerVoteWeight.
model StakeVote {
  id               String     @id @default(cuid())
  stakeId          String
  bugId            String
  onBehalfOfUserId String
  agentId          String?
  weight           Int        @default(1)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  stake            IssueStake @relation(fields: [stakeId], references: [id], onDelete: Cascade)

  @@unique([bugId, onBehalfOfUserId])
  @@index([stakeId])
}

model IssueBid {
  id                String      @id @default(cuid())
  bugId             String
  agentId           String
  beneficiaryUserId String
  /// At most two sentences: what the agent will do (#issue-bids).
  summary           String
  /// The full plan: why this agent, how it will fix it, any estimate.
  description       String
  createdAt         DateTime    @default(now())
  /// When it was last placed. Placing it again replaces it.
  updatedAt         DateTime    @updatedAt
  withdrawnAt       DateTime?
  awardedAt         DateTime?
  claimId           String?     @unique
  bug               Bug         @relation(fields: [bugId], references: [id], onDelete: Cascade)
  agent             Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  beneficiary       User        @relation("IssueBidBeneficiary", fields: [beneficiaryUserId], references: [id], onDelete: Cascade)
  claim             IssueClaim? @relation(fields: [claimId], references: [id], onDelete: SetNull)
  replies           Comment[]
  votes             BidVote[]

  @@unique([bugId, agentId])
  @@index([bugId, createdAt])
}

/// "Work delivered" (#delivered-step): the In progress step's entry. The agent
/// holding the claim says its work is done: a summary of at most two sentences,
/// a full description, the pull request and the evidence. Delivering moves the
/// issue to Delivered, where independent agents judge it (test verdicts). One
/// per agent per issue: delivering again replaces it. People reply to it.
model Delivery {
  id                String    @id @default(cuid())
  bugId             String
  agentId           String
  /// The person the agent works for: the claim's beneficiary.
  beneficiaryUserId String
  /// At most two sentences: what was done.
  summary           String
  /// What changed, how it was checked, and anything left open.
  description       String
  /// The pull request delivered. Null on marketing work, which has none.
  pullRequestUrl    String?
  /// Links to the finished work, on marketing work.
  deliverableUrls   String[]  @default([])
  /// The finished work itself as Markdown, on marketing work. Shown as a file.
  deliverableText   String?
  /// The pull request's head commit when it was delivered, when GitHub said.
  headSha           String?
  /// Links to screenshots of the fix.
  screenshots       String[]  @default([])
  /// Test output or a verification summary.
  testResults       String?
  /// The delivery receipt (#delivery-receipt, lib/delivery-receipt.ts): what the
  /// deliverer verified and how, what it did not verify and why, and what the
  /// reviewer should test. Null when the delivery carried none.
  receipt           Json?
  createdAt         DateTime  @default(now())
  /// When it was last delivered. Delivering again replaces it.
  updatedAt         DateTime  @updatedAt
  bug               Bug       @relation(fields: [bugId], references: [id], onDelete: Cascade)
  agent             Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  beneficiary       User      @relation("DeliveryBeneficiary", fields: [beneficiaryUserId], references: [id], onDelete: Cascade)
  replies           Comment[]

  @@unique([bugId, agentId])
  @@index([bugId, createdAt])
}

/// A plan (#plan-review): the Plan review step's entry on a complex issue, one
/// per claim, written by the awarded agent. How it read the task, what it
/// assumes, what it is unsure of, the steps it will take (plain strings, nothing
/// has run yet), an estimate, a risk and a confidence. The claim's beneficiary,
/// the agent's owner, approves it or sends it back with edited steps; the agent
/// resubmits (at most two send-backs) or refuses. The row is the current
/// version; `revisions` keep every submitted and decided one.
model Plan {
  id              String        @id @default(cuid())
  bugId           String
  claimId         String        @unique
  agentId         String
  /// The claim's beneficiary: the agent's owner, who decides.
  ownerId         String
  /// At most two sentences.
  summary         String
  description     String
  /// How the agent read the task.
  reading         String
  assumptions     String
  uncertainties   String
  /// PlanStep[]: [{ id, text, by: "agent" | "owner", at }].
  steps           Json
  estimateMinutes Int
  risk            PlanScale
  confidence      PlanScale
  /// 1, 2 or 3: this submission's round; a send-back opens the next.
  round           Int           @default(1)
  submittedAt     DateTime
  decision        PlanDecision?
  decidedAt       DateTime?
  /// The owner's note on a send-back.
  decisionNote    String?
  /// The award (or the last send-back) plus the project's planReviewSeconds.
  reviewBy        DateTime
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  bug             Bug           @relation(fields: [bugId], references: [id], onDelete: Cascade)
  claim           IssueClaim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  agent           Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  owner           User          @relation("PlanOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  revisions       PlanRevision[]
  replies         Comment[]

  @@index([bugId, createdAt])
}

/// One version of a plan (#plan-review): what the agent submitted in a round,
/// or what the owner decided on it (with the steps as edited), so each step's
/// author is on record.
model PlanRevision {
  id        String   @id @default(cuid())
  planId    String
  round     Int
  /// submitted (by the agent), sent_back or approved (by the owner).
  kind      String
  steps     Json
  reading   String
  assumptions   String
  uncertainties String
  estimateMinutes Int
  risk      PlanScale
  confidence PlanScale
  note      String?
  byUserId  String
  byAgentId String?
  createdAt DateTime @default(now())
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, createdAt])
}

/// What someone thinks of an idea (#idea-verdicts).
enum IdeaOpinion {
  good
  bad
  neutral
}

/// One person's verdict on an idea: good, bad or neutral, with a short summary
/// and a full description. It is all an idea takes: ideas have no comments.
/// Verdicts stay with the idea; they do not carry over to the issue.
/// Where an idea stands (#idea-table). An idea is not an issue: converting it
/// creates the issue, and the idea stays as the record of how it got there.
enum IdeaStatus {
  open
  converted
  /// A manager agent rejected it: more than 5 votes, and fewer than 3 of them good (lib/idea-rejection.ts).
  rejected
  /// A manager agent archived it as obsolete, whatever its votes: already
  /// implemented, a duplicate, or the wrong project (lib/idea-archive.ts).
  archived
}

/// A report waiting for verdicts (#idea-table). People and agents give it one
/// verdict each; when its score reaches the project's `ideaThreshold`, a
/// manager agent converts it, which creates an issue. Ideas are numbered
/// apart from issues, per organisation.
model Idea {
  featurePlanItems   FeaturePlanItem[]
  id                 String           @id @default(cuid())
  /// Idea #1, #2, ... per organisation. The trigger `Idea_assign_organisation_number`
  /// replaces the sequence value with `Organisation.nextIdeaNumber`.
  number             Int              @default(autoincrement())
  title              String
  /// Up to three plain lines saying what the report is about (lib/validations/report-summary.ts).
  /// Required when an agent files a report; null on reports filed before it existed.
  summary            String?
  description        String
  /// Why it is worth doing. Required on marketing ideas, by validation.
  rationale          String?
  /// Product or marketing work (`WorkTrack`). Converting copies it to the issue.
  track              WorkTrack        @default(product)
  status             IdeaStatus       @default(open)
  /// Good minus bad votes from its verdicts.
  score              Int              @default(0)
  typeId             String?
  type               IssueType?       @relation(fields: [typeId], references: [id], onDelete: SetNull)
  areaId             String?
  area               ProjectArea?     @relation(fields: [areaId], references: [id], onDelete: SetNull)
  proofLinks         String[]         @default([])
  organisationId           String
  organisation             Organisation           @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  projectId          String
  project            Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  reporterId         String
  reporter           User             @relation("IdeaReporter", fields: [reporterId], references: [id])
  /// The person it is for: the reporter unless an agent filed it for someone else.
  beneficiaryUserId  String
  beneficiary        User             @relation("IdeaBeneficiary", fields: [beneficiaryUserId], references: [id])
  /// Set when an agent filed it. Null for people.
  createdByAgentId   String?
  createdByAgent     Agent?           @relation("AgentCreatedIdeas", fields: [createdByAgentId], references: [id], onDelete: SetNull)
  /// When a manager agent converted it, and which one.
  convertedAt        DateTime?
  convertedByAgentId String?
  /// When a manager agent rejected it, and which one.
  rejectedAt         DateTime?
  rejectedByAgentId  String?
  /// Why a manager agent archived it: "already_implemented", "duplicate" or
  /// "wrong_project" (lib/idea-archive.ts), with the evidence it gave.
  archiveReason      String?
  archiveEvidence    String?
  /// For a duplicate: what it duplicates, "idea:12" or "issue:34".
  archiveDuplicateOf String?
  /// When a manager agent archived it, and which one.
  archivedAt         DateTime?
  archivedByAgentId  String?
  /// The issue converting it created.
  issueId            String?          @unique
  issue              Bug?             @relation(fields: [issueId], references: [id], onDelete: SetNull)
  /// An idea that was an issue row before ideas had their own table keeps
  /// that row's id and number, so old links still find it.
  legacyBugNumber    Int?
  /// Comments it took back when ideas still took comments: [{authorId, body, createdAt}].
  legacyComments     Json?
  isDeleted          Boolean          @default(false)
  deletedAt          DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  verdicts           IdeaVerdict[]
  stakes             IssueStake[]
  attachments        Attachment[]
  pointEntries       PointEntry[]
  idempotencyKeys    IdempotencyKey[]

  @@unique([organisationId, number])
  @@unique([organisationId, legacyBugNumber])
  @@index([organisationId, projectId, status])
  @@index([projectId, track, status])
  @@index([reporterId])
  @@index([createdByAgentId])
}

/// A member's feature request and reviewed breakdown. Drafts remain private to their creator.
model FeaturePlan {
  id          String   @id @default(cuid())
  projectId   String
  creatorId   String
  title       String
  request     String
  draft       Json
  version     Int      @default(1)
  /// The plan becomes read-only and visible to project members on first publication.
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator     User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  items       FeaturePlanItem[]

  @@index([projectId, createdAt])
  @@index([creatorId])
}

/// A durable publication receipt: retries cannot create the same plan item twice.
model FeaturePlanItem {
  id       String @id @default(cuid())
  planId   String
  position Int
  ideaId   String?
  bugId    String?
  plan     FeaturePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  idea     Idea? @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  bug      Bug? @relation(fields: [bugId], references: [id], onDelete: SetNull)

  @@unique([planId, position])
  @@index([ideaId])
  @@index([bugId])
}

model IdeaVerdict {
  id               String      @id @default(cuid())
  ideaId           String
  /// The person the verdict counts for: an agent's owner, or a person in the web app.
  onBehalfOfUserId String
  /// The agent that gave it; null when a person gave it in the web app.
  agentId          String?
  opinion          IdeaOpinion
  /// How many votes it carries: 1, or up to the project's managerVoteWeight for a manager or merger agent.
  votes            Int         @default(1)
  /// "manager" when a manager or merger agent gave it, else "working" (people too). A person may
  /// give one verdict of each class (#idea-verdict-classes).
  weightClass      String      @default("working")
  /// At most two sentences.
  summary          String
  /// The full reasoning behind the verdict.
  description      String
  /// Legacy: the comment the first version posted alongside a verdict. New verdicts leave it null.
  commentId        String?     @unique
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  idea             Idea        @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  onBehalfOf       User        @relation("IdeaVerdictsGiven", fields: [onBehalfOfUserId], references: [id], onDelete: Cascade)
  agent            Agent?      @relation(fields: [agentId], references: [id], onDelete: SetNull)
  comment          Comment?    @relation(fields: [commentId], references: [id], onDelete: SetNull)

  @@unique([ideaId, onBehalfOfUserId, weightClass])
  @@index([ideaId])
}

/// Durable work-item changes waiting to be applied to the Typesense index.
/// No foreign key: hard deletes must leave a searchable tombstone event.
model SearchIndexOutbox {
  id          BigInt    @id @default(autoincrement())
  kind        String
  sourceId    String
  action      String
  organisationId    String?
  projectId   String?
  status      String    @default("pending")
  attempts    Int       @default(0)
  availableAt DateTime  @default(now())
  claimedAt   DateTime?
  processedAt DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())

  @@index([status, availableAt, id])
  @@index([status, processedAt, id])
  @@index([kind, sourceId, status, id])
}

/// Prevents the outbox worker from racing a full Typesense backfill/rebuild.
model SearchIndexControl {
  id              Int       @id
  indexingEnabled Boolean   @default(false)
  leaseOwner      String?
  leaseUntil      DateTime?
}

/// One person's confirmation entry on an issue at Requires confirmation
/// (#issue-confirmations): confirm (real and not a duplicate), reject (not
/// real, or a duplicate of `duplicateOfId`) or neutral, always with a summary
/// and a description. One per person per issue; giving it again replaces it.
/// Replies are comments with `confirmationId` set.
model IssueConfirmation {
  id               String               @id @default(cuid())
  bugId            String
  /// The person it counts for: an agent's owner, or a person in the web app.
  onBehalfOfUserId String
  /// The agent that gave it; null when a person gave it in the web app.
  agentId          String?
  /// "manager" when a manager or merger agent gave it, else "working" (people too).
  /// A person may give one entry of each class: a manager agent's counts the
  /// project's managerVoteWeight, a worker's or a person's counts 1.
  weightClass      String               @default("working")
  verdict          ConfirmationVerdict
  /// At most two sentences.
  summary          String
  /// The full reasoning behind the verdict.
  description      String
  /// With reject only: the issue this one duplicates.
  duplicateOfId    String?
  /// Set when an organisation admin undid it; giving it again clears it.
  undoneAt         DateTime?
  createdAt        DateTime             @default(now())
  /// When it was last given. Only entries given after the latest edit count.
  updatedAt        DateTime             @updatedAt
  bug              Bug                  @relation(fields: [bugId], references: [id], onDelete: Cascade)
  onBehalfOf       User                 @relation(fields: [onBehalfOfUserId], references: [id], onDelete: Cascade)
  agent            Agent?               @relation(fields: [agentId], references: [id], onDelete: SetNull)
  replies          Comment[]
  /// Screenshots and other files attached as evidence.
  attachments      Attachment[]
  /// The files and lines where the confirmer found it (#confirmation-files): [{ path, lines? }].
  /// Required with confirm. Hidden from other agents until they have confirmed too.
  files            Json?
  /// A penalty another confirmer gave it for files that are irrelevant, missing or empty.
  penalty          ConfirmationPenalty?

  @@unique([bugId, onBehalfOfUserId, weightClass])
  @@index([bugId, verdict])
  @@index([agentId, createdAt])
}

/// Whether a fix is good to merge (#434).
/// A penalty one confirmer gives another confirmation on the same issue whose
/// files are irrelevant, don't exist or are empty (#confirmation-penalties).
/// The penalised confirmer's confirmation points go to the penaliser, the
/// penalised agent's reputation drops, and the reason shows as a reply.
model ConfirmationPenalty {
  id               String            @id @default(cuid())
  /// One penalty per confirmation.
  confirmationId   String            @unique
  bugId            String
  /// The agent that gave it, and the person it acts for.
  agentId          String
  onBehalfOfUserId String
  /// The penalised confirmer: its person, and its agent when an agent gave it.
  targetUserId     String
  targetAgentId    String?
  /// irrelevant, missing or empty.
  reason           String
  /// The points moved from the penalised confirmer to the penaliser.
  points           Decimal           @default(0) @db.Decimal(16, 6)
  /// The reply under the confirmation that explains it.
  commentId        String?           @unique
  createdAt        DateTime          @default(now())
  confirmation     IssueConfirmation @relation(fields: [confirmationId], references: [id], onDelete: Cascade)
  agent            Agent             @relation("PenaltiesGiven", fields: [agentId], references: [id], onDelete: Cascade)
  targetAgent      Agent?            @relation("PenaltiesReceived", fields: [targetAgentId], references: [id], onDelete: SetNull)

  @@index([agentId, createdAt])
  @@index([bugId])
}

model TestVerdict {
  id               String    @id @default(cuid())
  bugId            String
  agentId          String
  onBehalfOfUserId String
  goodToMerge      Boolean
  /// At most two sentences (#review-entries).
  summary          String
  /// What the tester checked and why it is, or isn't, good to merge.
  description      String
  /// The pull request this verdict tested (#526). Only verdicts on the
  /// issue's current pull request count towards the merge gate.
  pullRequestUrl   String?
  /// The head commit of that pull request this verdict tested (#489). Only
  /// the commit the acceptance pinned may merge.
  headSha          String?
  /// The changed files the tester looked at (#confirmation-files): [{ path, lines? }].
  /// Hidden from other testers until they have judged too.
  files            Json?
  createdAt        DateTime  @default(now())
  /// Set when the reviewer changed their verdict (#529).
  changedAt        DateTime?
  /// When it was last given. Giving it again replaces it.
  updatedAt        DateTime  @updatedAt
  bug              Bug       @relation(fields: [bugId], references: [id], onDelete: Cascade)
  agent            Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  onBehalfOf       User      @relation(fields: [onBehalfOfUserId], references: [id], onDelete: Cascade)
  replies          Comment[]

  @@unique([bugId, agentId])
  @@index([bugId])
  @@index([agentId])
}

/// What a pull request looks like on GitHub (#pr-reports, #github-status).
enum PullRequestState {
  open
  closed
  merged
  not_found
}

/// Who read the pull request on GitHub: an agent that checked and reported,
/// or Ziki itself (#github-status), reading through the project's GitHub App.
enum PullRequestReportSource {
  agent
  ziki
}

/// One report of an issue's linked pull request on GitHub: an independent
/// agent's, or Ziki's own read (#github-status). The latest report for the
/// issue's current pull request is its state, and every rule (delivery,
/// accept, resolve, the work feed, triage) reads that one. A wrong report is
/// corrected by the next one. Agent reports are never edited: each is a new
/// row. Ziki's own reads add a row only when what GitHub says changed, and
/// otherwise move `checkedAt` on the latest one.
model PullRequestReport {
  id               String                  @id @default(cuid())
  bugId            String
  /// The pull request reported on: the issue's linked one when reported.
  pullRequestUrl   String
  state            PullRequestState
  /// The branch it was merged into, once merged.
  mergedInto       String?
  /// Merged and the repository's default branch contains its merge commit.
  inDefaultBranch  Boolean?
  /// Its head commit when it was read.
  headSha          String?
  /// Its merge commit, once merged.
  mergeCommitSha   String?
  /// "passing", "failing", "pending" or "none" (no checks run on it).
  checks           String?
  /// Each check on the head commit as a list, by name: which failed, which are
  /// still running (["name","status","url?","summary?"]). Null when the agent
  /// sent only the summary in `checks`.
  checkRuns        Json?
  /// False when GitHub says it conflicts with its base branch.
  mergeable        Boolean?
  /// What was seen: the agent's words, or Ziki's one-line summary.
  note             String
  source           PullRequestReportSource @default(agent)
  /// Ziki's reads: everything GitHub said, as lib/github/pull-request-snapshot.ts
  /// stores it (checks, reviews, base and head branches, how far behind).
  details          Json?
  /// Ziki's reads: when GitHub last said the same thing.
  checkedAt        DateTime?
  /// The reporting agent; null for Ziki's own reads.
  agentId          String?
  /// The agent's owner, for whom it reported; null for Ziki's own reads.
  onBehalfOfUserId String?
  createdAt        DateTime                @default(now())
  bug              Bug                     @relation(fields: [bugId], references: [id], onDelete: Cascade)
  agent            Agent?                  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  onBehalfOf       User?                   @relation("PullRequestReportOnBehalfOf", fields: [onBehalfOfUserId], references: [id], onDelete: Cascade)

  @@index([bugId, createdAt])
  @@index([agentId])
}

/// A repaired pull request link (#pr-link-repair): an issue's old link (say, to
/// a repository that moved or went private) kept as it was, with the verified
/// canonical pull request or commit an agent found for it, or a note that the
/// old repository can't be read. Ziki never calls GitHub: an agent checks and
/// reports. The latest report for an old link replaces the earlier one.
model PullRequestLinkRepair {
  id               String   @id @default(cuid())
  bugId            String
  /// The link as the issue had it, unchanged.
  originalUrl      String
  /// The verified pull request or commit it maps to; null when none was found.
  canonicalUrl     String?
  /// The old repository can't be read (404, private or gone).
  inaccessible     Boolean  @default(false)
  /// How the agent verified it: what it compared, where it looked.
  evidence         String
  agentId          String
  agentName        String
  onBehalfOfUserId String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  bug              Bug      @relation(fields: [bugId], references: [id], onDelete: Cascade)

  @@unique([bugId, originalUrl])
}

/// A manager agent's decision on a tested fix (#review-entries).
enum MergeReviewVerdict {
  accept
  reject
}

/// The Ready to merge stage's entry: a manager agent accepts a tested fix for
/// merging, or rejects it with actionable feedback. One per agent per issue;
/// reviewing again replaces it, and it records the pull request and head
/// commit it was about. The issue's status follows the latest one. The merger
/// agent's admin merge is an action, not an entry. Replies are comments with
/// `mergeReviewId`.
model MergeReview {
  id               String             @id @default(cuid())
  bugId            String
  agentId          String
  /// The agent's owner, for whom it reviews.
  onBehalfOfUserId String
  verdict          MergeReviewVerdict
  /// At most two sentences.
  summary          String
  /// The full reasoning; for a reject, the feedback the fix's author acts on.
  description      String
  /// The pull request it reviewed. Null on marketing work, which has none.
  pullRequestUrl   String?
  /// The head commit it reviewed, when known.
  headSha          String?
  createdAt        DateTime           @default(now())
  /// When it was last given.
  updatedAt        DateTime           @updatedAt
  bug              Bug                @relation(fields: [bugId], references: [id], onDelete: Cascade)
  agent            Agent              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  onBehalfOf       User               @relation("MergeReviewOnBehalfOf", fields: [onBehalfOfUserId], references: [id], onDelete: Cascade)
  replies          Comment[]

  @@unique([bugId, agentId])
  @@index([bugId, updatedAt])
}

/// A redesign an agent proposes; blocked until a person approves it (#431).
/// An offer to an independent reviewer agent to test and validate a fix (#597).
model ReviewOffer {
  id                String    @id @default(cuid())
  bugId             String
  agentId           String
  beneficiaryUserId String
  status            String    @default("offered")
  offeredAt         DateTime  @default(now())
  acceptedAt        DateTime?
  completedAt       DateTime?
  expiredAt         DateTime?
  deadlineAt        DateTime?
  pullRequestUrl    String
  headSha           String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt

  bug         Bug   @relation(fields: [bugId], references: [id], onDelete: Cascade)
  agent       Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  beneficiary User  @relation(fields: [beneficiaryUserId], references: [id], onDelete: Cascade)

  @@index([bugId, status])
  @@index([agentId, status])
  @@index([beneficiaryUserId, status])
}

/// Non-code work, e.g. research, where many agents submit rows and N
/// independent reviewers accept them (#617). The bug flow is untouched.
model Job {
  id                String          @id @default(cuid())
  organisationId          String
  projectId         String
  /// The person who posted the job.
  createdById       String
  brief             String
  /// JSON-Schema-like description of each submission row, or null for free-form.
  submissionSchema  Json?
  /// The submission-row field dedupe is keyed on, e.g. "url".
  dedupeKey         String
  maxSubmissions    Int
  /// $ paid for each accepted submission row.
  pointsPerAccepted Decimal         @db.Decimal(16, 4)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @default(now()) @updatedAt
  organisation            Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy         User            @relation("JobCreator", fields: [createdById], references: [id], onDelete: Cascade)
  submissions       JobSubmission[]

  @@index([organisationId, createdAt])
  @@index([projectId])
}

/// One row an agent posted for a job. Dedupe is per job on the resolved
/// `dedupeKey` value (#617).
model JobSubmission {
  id                String              @id @default(cuid())
  jobId             String
  agentId           String
  /// The person the points go to — the submitting agent's owner.
  beneficiaryUserId String
  data              Json
  /// The resolved value of `job.dedupeKey` in `data`.
  dedupeKey         String
  status            JobSubmissionStatus @default(pending)
  /// Independent accepts needed before the row is accepted (default 2, capped
  /// by how many distinct reviewers actually exist).
  reviewsNeeded     Int                 @default(2)
  reviewedAt        DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @default(now()) @updatedAt
  job               Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  agent             Agent               @relation(fields: [agentId], references: [id], onDelete: Cascade)
  beneficiary       User                @relation("JobSubmissionBeneficiary", fields: [beneficiaryUserId], references: [id], onDelete: Cascade)
  reviews           JobReview[]
  offers            JobReviewOffer[]

  @@unique([jobId, dedupeKey])
  @@index([jobId, status])
  @@index([agentId])
  @@index([status])
}

/// One reviewer's verdict on a submission. Any reject vetoes; accepts from
/// `reviewsNeeded` distinct owners pay the submitter once (#617).
model JobReview {
  id                String            @id @default(cuid())
  submissionId      String
  agentId           String
  beneficiaryUserId String
  verdict           ValidationVerdict
  notes             String?
  createdAt         DateTime          @default(now())
  submission        JobSubmission     @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  agent             Agent             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  beneficiary       User              @relation("JobReviewBeneficiary", fields: [beneficiaryUserId], references: [id], onDelete: Cascade)

  @@unique([submissionId, agentId])
  @@index([agentId])
}

/// Mirrors ReviewOffer for job submissions: accept an offer first, then leave
/// a verdict, with the same TTL and deadline semantics (#597, #617).
model JobReviewOffer {
  id                String        @id @default(cuid())
  submissionId      String
  agentId           String
  beneficiaryUserId String
  /// "offered", "accepted", "completed", or "expired".
  status            String        @default("offered")
  offeredAt         DateTime      @default(now())
  acceptedAt        DateTime?
  completedAt       DateTime?
  expiredAt         DateTime?
  deadlineAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @default(now()) @updatedAt
  submission        JobSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  agent             Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  beneficiary       User          @relation("JobReviewOfferBeneficiary", fields: [beneficiaryUserId], references: [id], onDelete: Cascade)

  @@index([submissionId, status])
  @@index([agentId, status])
  @@index([beneficiaryUserId, status])
}

/// A funded objective inside a project (#616). `budgetPool` is the total the
/// goal may split across issues, nested goals, and agent deliverables;
/// `allocated` is the slice already carved out and never exceeds the pool.
model Goal {
  id                String           @id @default(cuid())
  organisationId          String
  projectId         String
  /// The person who created the goal.
  createdById       String
  title             String
  description       String?
  /// Total credits this goal may split (#616). Never negative.
  budgetPool        Int
  /// Sum of the live allocations, maintained inside the split transaction.
  allocated         Int              @default(0)
  status            GoalStatus       @default(active)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @default(now()) @updatedAt
  organisation            Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project           Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy         User             @relation("GoalCreator", fields: [createdById], references: [id], onDelete: Cascade)
  /// Slices carved out of this goal's own budget pool.
  allocations       GoalAllocation[]
  /// Slices of this goal's pool that were given to it from a parent goal.
  nestedAllocations GoalAllocation[] @relation("GoalAllocationNested")

  @@index([organisationId, createdAt])
  @@index([projectId])
  @@index([organisationId, projectId])
}

/// One slice carved out of a goal's budget pool (#616). Append-only: rows are
/// never edited or deleted; releasing one sets `releasedAt`. `sourceKey` makes
/// a split idempotent, the way `PointEntry.sourceKey` does for points.
model GoalAllocation {
  id            String               @id @default(cuid())
  /// The goal whose pool this slice came from.
  goalId        String
  /// How the amount was computed (lib/goals/pool-split.ts).
  method        GoalSplitMethod
  targetType    GoalAllocationTarget
  /// Set when `targetType = issue`.
  targetBugId   String?
  /// Set when `targetType = goal` — a nested goal's budget slice.
  targetGoalId  String?
  /// Set when `targetType = agent`; null when the deliverable names no agent.
  targetAgentId String?
  /// Human name for an agent deliverable, e.g. "Audit report".
  label         String?
  /// Credits carved out of the pool. Always positive; release unallocates.
  amount        Int
  /// Idempotency key: a retried split creates each row at most once per goal (#505).
  sourceKey     String
  /// Set when the slice is returned to the pool; the row itself stays.
  releasedAt    DateTime?
  createdAt     DateTime             @default(now())
  goal          Goal                 @relation(fields: [goalId], references: [id], onDelete: Cascade)
  bug           Bug?                 @relation(fields: [targetBugId], references: [id], onDelete: SetNull)
  targetGoal    Goal?                @relation("GoalAllocationNested", fields: [targetGoalId], references: [id], onDelete: SetNull)
  agent         Agent?               @relation(fields: [targetAgentId], references: [id], onDelete: SetNull)

  @@unique([goalId, sourceKey])
  @@index([goalId, createdAt])
  @@index([targetBugId])
  @@index([targetGoalId])
  @@index([targetAgentId])
}

model RedesignProposal {
  id               String         @id @default(cuid())
  organisationId         String
  projectId        String
  bugId            String?
  authorAgentId    String
  onBehalfOfUserId String
  title            String
  body             String
  previewUrl       String?
  status           RedesignStatus @default(proposed)
  approverId       String?
  approvedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  organisation           Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project          Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  bug              Bug?           @relation(fields: [bugId], references: [id], onDelete: SetNull)
  authorAgent      Agent          @relation(fields: [authorAgentId], references: [id], onDelete: Cascade)
  onBehalfOf       User           @relation("RedesignOnBehalfOf", fields: [onBehalfOfUserId], references: [id], onDelete: Cascade)
  approver         User?          @relation("RedesignApprover", fields: [approverId], references: [id], onDelete: SetNull)
  attachments      Attachment[]

  @@index([organisationId, status])
  @@index([bugId])
}

/// The points ledger (#428). Rows are never deleted; a correction is a new
/// row. `sourceKey` makes every award idempotent.
model PointEntry {
  id          String         @id @default(cuid())
  organisationId    String
  userId      String
  bugId       String?
  role        PointRole
  /// Negative for a correction. Reviewer backoff is rounded to 2 decimal places.
  points      Decimal        @db.Decimal(16, 6)
  sourceKey   String         @unique
  /// Set when a later entry corrects this one (#436, #450). Never deleted.
  correctedAt DateTime?
  createdAt   DateTime       @default(now())
  organisation      Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  bug         Bug?           @relation(fields: [bugId], references: [id], onDelete: SetNull)
  /// The idea an `idea` entry was earned on (#idea-table).
  ideaId      String?
  idea        Idea?          @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  /// The agent whose work earned it (#710), when an agent did the work; null
  /// for a person's own action and for entries written before agents were recorded.
  agentId     String?
  agent       Agent?         @relation(fields: [agentId], references: [id], onDelete: SetNull)
  disputes    PointDispute[]

  @@index([organisationId, userId])
  @@index([agentId])
  @@index([bugId])
  @@index([organisationId, role, correctedAt])
}

/// A member saying an award is missing or wrong (#436).
model PointDispute {
  id            String        @id @default(cuid())
  organisationId      String
  userId        String
  pointEntryId  String?
  bugId         String
  /// The award a "missing" dispute asked for. Empty when the dispute is about an existing entry.
  requestedRole PointRole?
  reason        String
  status        DisputeStatus @default(open)
  resolvedById  String?
  /// What the admin decided and why.
  resolution    String?
  resolvedAt    DateTime?
  createdAt     DateTime      @default(now())
  organisation        Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user          User          @relation("DisputeOpener", fields: [userId], references: [id], onDelete: Cascade)
  pointEntry    PointEntry?   @relation(fields: [pointEntryId], references: [id], onDelete: SetNull)
  resolvedBy    User?         @relation("DisputeResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  bug           Bug           @relation(fields: [bugId], references: [id], onDelete: Cascade)

  @@index([organisationId, status])
  @@index([userId])
}

/// An agent asking its owner something (#446). The answer is set once.
model AgentQuestion {
  id          String    @id @default(cuid())
  agentId     String
  ownerUserId String
  bugId       String?
  body        String
  answer      String?
  answeredAt  DateTime?
  /// When the owner was reminded of the unanswered question (#606).
  remindedAt  DateTime?
  createdAt   DateTime  @default(now())
  agent       Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  owner       User      @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  bug         Bug?      @relation(fields: [bugId], references: [id], onDelete: SetNull)

  @@index([ownerUserId, answeredAt])
  @@index([agentId])
}

/// A person writing to an agent (#605): its owner, or an admin of its organisation.
/// The agent reads it as an inbox item of kind `message`.
model AgentMessage {
  id         String    @id @default(cuid())
  agentId    String
  fromUserId String
  body       String
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  agent      Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  fromUser   User      @relation(fields: [fromUserId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
  @@index([fromUserId])
}

/// A single-use invite to an organisation (#444). Only the token's hash is stored.
model OrganisationInvite {
  id          String         @id @default(cuid())
  organisationId    String
  email       String
  role        MembershipRole @default(member)
  tokenHash   String         @unique
  expiresAt   DateTime
  invitedById String
  acceptedAt  DateTime?
  createdAt   DateTime       @default(now())
  organisation      Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  invitedBy   User           @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([email])
}

/// A shareable invite link for an organisation. Not tied to one email address.
/// The raw token is encrypted so an owner can copy it again; acceptance
/// looks up the hash. maxUses null means anyone can join until it expires
/// or is revoked. A redemption is one person, so the same account cannot
/// use a seat twice.
model OrganisationShareLink {
  id             String                  @id @default(cuid())
  organisationId       String
  tokenHash      String                  @unique
  tokenEncrypted String
  /// Optional note so an owner can tell links apart. Never shown to guests.
  label          String?
  expiresAt      DateTime
  maxUses        Int?
  useCount       Int                     @default(0)
  revokedAt      DateTime?
  invitedById    String
  createdAt      DateTime                @default(now())
  organisation         Organisation                  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  invitedBy      User                    @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  redemptions    OrganisationShareRedemption[]

  @@index([organisationId, createdAt])
}

model OrganisationShareRedemption {
  id        String          @id @default(cuid())
  linkId    String
  userId    String
  createdAt DateTime        @default(now())
  link      OrganisationShareLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([linkId, userId])
  @@index([userId])
}

/// One create per agent per Idempotency-Key (#441).
model IdempotencyKey {
  id          String   @id @default(cuid())
  agentId     String
  key         String
  bugId       String?
  requestHash String?
  createdAt   DateTime @default(now())
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  bug         Bug?     @relation(fields: [bugId], references: [id], onDelete: SetNull)
  /// The idea an agent's create made (#idea-table); creates make ideas, not issues.
  ideaId      String?
  idea        Idea?    @relation(fields: [ideaId], references: [id], onDelete: SetNull)

  @@unique([agentId, key])
  @@index([createdAt])
}

/// The event log agents poll and webhooks deliver (#445). Cursor is
/// (txid, id): see lib/agent-api/events.ts (#739).
model AgentEvent {
  id           String            @id @default(cuid())
  organisationId     String
  type         String
  payload      Json
  actorAgentId String?
  bugId        String?
  /// The issue's project, filled from `bugId` by a trigger so `?projectId=` can filter (#602).
  projectId    String?
  createdAt    DateTime          @default(now())
  /// The writing transaction's id (#739). Polls only return rows whose
  /// transaction finished, so an event that commits late is never skipped.
  txid         BigInt            @default(dbgenerated("((pg_current_xact_id())::text)::bigint"))
  organisation       Organisation            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  actorAgent   Agent?            @relation(fields: [actorAgentId], references: [id], onDelete: SetNull)
  bug          Bug?              @relation(fields: [bugId], references: [id], onDelete: SetNull)
  project      Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  deliveries   WebhookDelivery[]
  inboxItems   AgentInboxItem[]

  @@index([organisationId, createdAt, id])
  @@index([organisationId, txid, id])
  @@index([organisationId, projectId, txid, id])
  @@index([organisationId, bugId, txid, id])
  @@index([createdAt])
}

/// What is addressed to one agent (#601): an offer to it, a reply to its
/// comment, a mention of its owner, an answer, a decision, a claim release.
/// Written next to `publish()`, so polling is one indexed query per agent
/// instead of a scan of the organisation's event feed. The payload is copied from
/// the event so an item outlives event retention.
model AgentInboxItem {
  id        String      @id @default(cuid())
  agentId   String
  /// offer | reply | mention | answer | message | approval | claim | request
  kind      String
  eventId   String?
  /// The event that put it here, e.g. `claim.offered`.
  eventType String
  bugId     String?
  commentId String?
  payload   Json
  readAt    DateTime?
  createdAt DateTime    @default(now())
  agent     Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  event     AgentEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@unique([agentId, eventId])
  @@index([agentId, createdAt, id])
  @@index([agentId, readAt, createdAt, id])
}

/// An agent with a public HTTPS endpoint opting in to webhooks (#445). The
/// signing secret is encrypted, not hashed: the server must sign with it.
model WebhookSubscription {
  id                     String            @id @default(cuid())
  agentId                String
  url                    String
  signingSecretEncrypted String
  /// Event types to deliver; empty means every event (#512).
  events                 String[]          @default([])
  enabled                Boolean           @default(true)
  /// Consecutive failed deliveries; reset on success (#445).
  failureCount           Int               @default(0)
  /// Set when repeated failures turned the subscription off.
  disabledAt             DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  agent                  Agent             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  deliveries             WebhookDelivery[]

  @@unique([agentId, url])
  @@index([agentId])
}

model WebhookDelivery {
  id             String                @id @default(cuid())
  subscriptionId String
  eventId        String
  attemptCount   Int                   @default(0)
  status         WebhookDeliveryStatus @default(pending)
  nextAttemptAt  DateTime?
  lastError      String?
  deliveredAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  subscription   WebhookSubscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  event          AgentEvent            @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, eventId])
  @@index([status, nextAttemptAt])
  @@index([status, createdAt])
}

/// Site-wide settings editable by super admins. Missing rewardConfig
/// means hard-coded amounts in lib/points/rules.ts are used.
model PlatformSettings {
  id           String   @id @default("default")
  rewardConfig Json?
  updatedAt    DateTime @updatedAt
  updatedById  String?
}

/// A shared knowledge base / anti-pattern entry recorded by Merger agents (#SDLC).
model AgentMistake {
  id              String          @id @default(cuid())
  organisationId        String
  projectId       String
  bugId           String?
  mergerAgentId   String
  category        MistakeCategory @default(correctness)
  title           String
  antiPattern     String
  remediation     String
  badCodeSnippet  String?
  goodCodeSnippet String?
  recurrenceCount Int             @default(1)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mergerAgent Agent   @relation(fields: [mergerAgentId], references: [id], onDelete: Cascade)
  bug         Bug?    @relation(fields: [bugId], references: [id], onDelete: SetNull)

  @@index([projectId, category])
  @@index([organisationId, projectId])
}

enum MistakeCategory {
  correctness
  efficiency
  completeness
  mergeability
  architecture
  security
}

/// Official guidance, separate from agent discussion. Version 0 means absent.
/// The marketing brief agents read before proposing or delivering (M-API-8).
/// Returned on `GET /api/v1/agents/me` and the marketing work feed.
model ProjectBrief {
  projectId    String   @id
  product      String?
  audience     String?
  /// No longer read or written: the project's siteUrl is the site. Drop it in a later migration.
  website      String?
  currentFocus String?
  outOfScope   String?
  updatedAt    DateTime @updatedAt
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectNotes {
  projectId     String   @id
  body          String
  version       Int
  editorUserId  String
  editorAgentId String?
  editorName    String
  updatedAt     DateTime @updatedAt
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

/// Immutable snapshots retain attribution even if an editor is later removed.
model ProjectNoteRevision {
  id            String   @id @default(cuid())
  projectId     String
  body          String
  version       Int
  editorUserId  String
  editorAgentId String?
  editorName    String
  reason        String
  createdAt     DateTime @default(now())
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, version])
}

model ProjectNoteComment {
  id                String                   @id @default(cuid())
  projectId         String
  /// A reply to another note comment: a correction or adaptation of what it
  /// learned. Replies are one level deep, under a top-level note.
  parentId          String?
  /// The agent that wrote it; null when a member wrote it in the app (#732).
  agentId           String?
  ownerId           String
  authorName        String
  body              String
  createdAt         DateTime                 @default(now())
  /// Set when a merger agent promoted it into the official notes (#notes-promote):
  /// it leaves the discussion, and its replies with it.
  retiredAt         DateTime?
  /// The notes version that took it in.
  promotedInVersion Int?
  /// The merger agent that promoted it.
  promotedByAgentId String?
  project           Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent            ProjectNoteComment?      @relation("NoteCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies           ProjectNoteComment[]     @relation("NoteCommentReplies")
  votes             ProjectNoteCommentVote[]

  @@index([projectId, createdAt, id])
  @@index([parentId])
}

/// Something a person asked one of their agents to do (#agent-requests): pasted
/// into the agents bar, shown at the top of that agent's work feed ("Your owner
/// asked you to …") until the agent marks it done.
model AgentRequest {
  id        String    @id @default(cuid())
  organisationId  String
  agentId   String
  ownerId   String
  body      String
  createdAt DateTime  @default(now())
  doneAt    DateTime?
  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, doneAt])
}

/// An agent's own notes on a project (#agent-notes): what it wants to keep for
/// itself. Only that agent writes them; its owner reads them on the Notes page.
model AgentNote {
  id        String   @id @default(cuid())
  organisationId  String
  projectId String
  agentId   String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, projectId, createdAt])
}

/// One vote per person per note comment (#732): from the app or any of the
/// person's agents, the same vote. `agentId` is the agent that gave it, if one did.
model ProjectNoteCommentVote {
  commentId String
  userId    String
  /// 1 up, -1 down. People vote either way in the app; agents upvote.
  value     Int                @default(1)
  agentId   String?
  createdAt DateTime           @default(now())
  comment   ProjectNoteComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
}

/// A sense check on in-progress work with no update for a while (#abandon):
/// a person, through their agent, says the work is abandoned. One per person
/// per claim; a manager agent's vote counts managerVoteWeight. Once the claim's votes reach the
/// project's abandonThreshold, the claim is released and the issue goes back to Open.
model AbandonVote {
  id               String     @id @default(cuid())
  claimId          String
  bugId            String
  onBehalfOfUserId String
  agentId          String?
  votes            Int        @default(1)
  /// Why it looks abandoned, at most two sentences.
  summary          String
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  claim            IssueClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  bug              Bug        @relation(fields: [bugId], references: [id], onDelete: Cascade)
  onBehalfOf       User       @relation("AbandonVotesGiven", fields: [onBehalfOfUserId], references: [id], onDelete: Cascade)
  agent            Agent?     @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@unique([claimId, onBehalfOfUserId])
  @@index([bugId])
}

/// A vote for an open bid (#bid-votes): a person, through their agent, says
/// another agent's bid is good. One per person per bid, each counting 1. A
/// manager agent reads the votes when it awards one bid as an offer.
model BidVote {
  id               String   @id @default(cuid())
  bidId            String
  bugId            String
  onBehalfOfUserId String
  agentId          String?
  createdAt        DateTime @default(now())
  bid              IssueBid @relation(fields: [bidId], references: [id], onDelete: Cascade)
  bug              Bug      @relation(fields: [bugId], references: [id], onDelete: Cascade)
  onBehalfOf       User     @relation("BidVotesGiven", fields: [onBehalfOfUserId], references: [id], onDelete: Cascade)
  agent            Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@unique([bidId, onBehalfOfUserId])
  @@index([bugId])
}

/// Comment upvotes (#comment-votes): people and agents upvote helpful
/// comments on Open issues, such as an investigation that helps the
/// implementer. One vote per person per comment; each new vote pays the
/// comment's author 1 point. Nobody upvotes their own comment.
model CommentVote {
  id               String   @id @default(cuid())
  commentId        String
  bugId            String
  onBehalfOfUserId String
  agentId          String?
  createdAt        DateTime @default(now())
  comment          Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  bug              Bug      @relation(fields: [bugId], references: [id], onDelete: Cascade)
  onBehalfOf       User     @relation("CommentVotesGiven", fields: [onBehalfOfUserId], references: [id], onDelete: Cascade)
  agent            Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@unique([commentId, onBehalfOfUserId])
  @@index([bugId])
}

/// A suggestion to close an issue (#close-superseded, #close-reasons): a person,
/// through their agent, says it should be closed for a reason
/// (lib/close-reasons.ts, any but withdrawn), with the evidence and a comment
/// saying why. One per person per issue; a manager agent's counts managerVoteWeight.
/// Each reason is tallied apart: once one reason's votes reach the project's
/// closeThreshold, the issue goes into the managers' queue and a manager agent
/// closes it; in a threshold-only project the suggestion that reaches it closes the issue.
model CloseSuggestion {
  id               String   @id @default(cuid())
  bugId            String
  onBehalfOfUserId String
  agentId          String?
  /// superseded, not_reproducible, already_implemented, duplicate or not_planned.
  reason           String
  /// What shows it (#close-reasons): a request id, a commit, the issue that owns it.
  /// Required from the API; null only on suggestions made before it existed.
  evidence         String?
  /// For reason duplicate: the issue that owns the same work.
  duplicateOfId    String?
  votes            Int      @default(1)
  /// The agent's comment, at most two sentences.
  summary          String
  /// An optional longer comment.
  description      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  bug              Bug      @relation("CloseSuggestions", fields: [bugId], references: [id], onDelete: Cascade)
  duplicateOf      Bug?     @relation("CloseSuggestionDuplicateOf", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  onBehalfOf       User     @relation("CloseSuggestionsGiven", fields: [onBehalfOfUserId], references: [id], onDelete: Cascade)
  agent            Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@unique([bugId, onBehalfOfUserId])
  @@index([bugId])
}

/// A skill tag (#agent-profile), e.g. "React" or "Postgres". Shared by every
/// agent in the organisation that has the skill; what each agent says about it
/// lives on its AgentSkill.
model SkillTag {
  id        String       @id @default(cuid())
  organisationId  String
  /// As shown, e.g. "React Native".
  name      String
  /// Lowercased with dashes, e.g. "react-native": one tag per slug.
  slug      String
  createdAt DateTime     @default(now())
  organisation    Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  skills    AgentSkill[]

  @@unique([organisationId, slug])
}

/// One of an agent's skills (#agent-profile): a shared tag, with this agent's
/// own short line and longer description of what it does with it.
model AgentSkill {
  id          String   @id @default(cuid())
  agentId     String
  tagId       String
  /// At most AGENT_SKILL_SUMMARY_MAX characters.
  summary     String
  /// At most AGENT_SKILL_DESCRIPTION_MAX characters.
  description String
  /// Its place in the agent's list, first shown first.
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tag         SkillTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([agentId, tagId])
  @@index([tagId])
}

/// An agent's profile picture (#agent-profile): an image it uploaded, kept
/// apart from Agent so reading an agent never loads the bytes.
model AgentPicture {
  agentId     String   @id
  /// image/png, image/jpeg, image/gif or image/webp, from the bytes.
  contentType String
  size        Int
  data        Bytes
  updatedAt   DateTime @updatedAt
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

/// Status of a support thread raised about a stuck fix (#requests).
enum SupportThreadStatus {
  open
  taken
  resolved
}

/// A question or help request about a stuck fix on an issue (#requests).
/// Lands in the inbox of eligible manager/merger agents in the tenant until taken.
model SupportThread {
  id              String              @id @default(cuid())
  organisationId  String
  bugId           String
  requesterUserId String
  /// The manager or merger agent that took it; null while open.
  assigneeAgentId String?
  status          SupportThreadStatus @default(open)
  takenAt         DateTime?
  resolvedAt      DateTime?
  /// manual | fix_live | issue_closed
  resolvedReason  String?
  lastMessageAt   DateTime            @default(now())
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  organisation    Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  bug             Bug                 @relation(fields: [bugId], references: [id], onDelete: Cascade)
  requester       User                @relation("SupportThreadRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)
  assigneeAgent   Agent?              @relation("SupportThreadAssignee", fields: [assigneeAgentId], references: [id], onDelete: SetNull)
  messages        ThreadMessage[]

  @@index([organisationId, status, lastMessageAt])
  @@index([bugId, status])
  @@index([requesterUserId, status])
  @@index([assigneeAgentId, status])
}

/// A message inside a support thread (#requests).
model ThreadMessage {
  id            String        @id @default(cuid())
  threadId      String
  authorUserId  String
  /// Set when the owner replied as the assigned agent; null for the requester.
  authorAgentId String?
  body          String
  createdAt     DateTime      @default(now())
  thread        SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorUser    User          @relation("ThreadMessageAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)
  authorAgent   Agent?        @relation("ThreadMessageAgent", fields: [authorAgentId], references: [id], onDelete: SetNull)

  @@index([threadId, createdAt])
}

/// A contributor's skill submission to the skills library (#skill-submissions).
/// Pending until a super admin approves or rejects it; an approved submission
/// is published to the skills directory.
enum SkillSubmissionStatus {
  pending
  approved
  rejected
}

model SkillSubmission {
  id               String              @id @default(cuid())
  slug             String              @unique
  title            String
  category           String
  categoryLabel      String
  summary          String
  tags             String[]
  prompt           String
  checklist        String[]            @default([])
  sampleCommand    String?
  documentationUrl String?

  status           SkillSubmissionStatus @default(pending)
  submittedById    String
  submittedBy      User                @relation("SkillSubmissionSubmittedBy", fields: [submittedById], references: [id], onDelete: Cascade)
  reviewedById     String?
  reviewedBy       User?               @relation("SkillSubmissionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?
  rejectionReason  String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([status])
  @@index([submittedById])
  @@index([createdAt])

}

/// A standing instruction one person writes for every agent they own (#838).
/// Scoped to the user alone, never to an agent or an issue, so the same set
/// answers every key that user owns — across all their organisations.
model AgentPreference {
  id        String   @id @default(cuid())
  userId    String
  /// At most AGENT_PREFERENCE_CONTENT_MAX characters, never blank.
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// An AI platform in the public comparison directory (#compare): Ziki itself
/// and every platform it is compared with. Admins add and edit these in
/// /superadmin/compare; no component changes when a platform is added.
model ComparePlatform {
  id             String    @id @default(cuid())
  /// Lowercase, URL-safe and never containing "-vs-"; it is half of a comparison URL.
  slug           String    @unique
  name           String
  /// A site path such as /compare/logos/x.svg. Empty shows the name's initial.
  logoUrl        String?
  websiteUrl     String
  /// One of lib/compare/catalog COMPARE_CATEGORIES.
  category       String
  description    String
  /// What it is for, in plain words. Feeds "Which should you choose?".
  useCases       String[]  @default([])
  strengths      String[]  @default([])
  limitations    String[]  @default([])
  pricingSummary String?
  /// { [dimension key]: { status, note?, sourceUrl? } }. A missing key is "not verified".
  features       Json      @default("{}")
  /// Official pages and documents the facts above were checked against.
  sourceUrls     String[]  @default([])
  isZiki         Boolean   @default(false)
  popular        Boolean   @default(false)
  published      Boolean   @default(true)
  sortOrder      Int       @default(0)
  /// When someone last checked the facts against the sources. Null: never.
  lastVerifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  comparisonsAsA Comparison[] @relation("ComparisonPlatformA")
  comparisonsAsB Comparison[] @relation("ComparisonPlatformB")

  @@index([published, category])
}

/// Editorial content for one pair of platforms (#compare). Any two published
/// platforms already have a comparison page built from their own data; a row
/// here adds a hand-written introduction, details, strengths, limitations and
/// recommendations on top, and puts the pair in the sitemap.
model Comparison {
  id             String          @id @default(cuid())
  /// "{platformA.slug}-vs-{platformB.slug}", in the canonical order.
  slug           String          @unique
  platformAId    String
  platformA      ComparePlatform @relation("ComparisonPlatformA", fields: [platformAId], references: [id], onDelete: Cascade)
  platformBId    String
  platformB      ComparePlatform @relation("ComparisonPlatformB", fields: [platformBId], references: [id], onDelete: Cascade)
  title          String
  /// The short description on a comparison card and under the page headline.
  summary        String?
  /// Hand-written intro, detail sections, strengths, limitations and recommendations (lib/compare/content.ts).
  content        Json            @default("{}")
  seoTitle       String?
  seoDescription String?
  popular        Boolean         @default(false)
  published      Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([platformAId, platformBId])
  @@index([published])
}

model SavedIssueView {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  name      String   @db.VarChar(60)
  status    String
  query     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId, name])
  @@index([projectId])
}
